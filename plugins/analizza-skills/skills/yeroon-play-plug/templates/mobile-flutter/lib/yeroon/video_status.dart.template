const Map<String, String> _labels = {
  'PENDENTE': 'Enviando',
  'ENVIADO': 'Na fila',
  'PROCESSANDO': 'Convertendo',
  'PRONTO': 'Pronto',
  'FALHOU': 'Falhou',
  'CANCELADO': 'Cancelado',
  'ABANDONADO': 'Abandonado',
};

/// Rótulo curto do status que o back devolve; desconhecido aparece como veio.
String statusLabel(String status) => _labels[status] ?? status;

/// Estados em que o vídeo ainda muda: a tela consulta de novo.
const activeStatuses = {'PENDENTE', 'ENVIADO', 'PROCESSANDO'};

/// Estados finais: nada mais muda, então a consulta para.
const terminalStatuses = {'PRONTO', 'FALHOU', 'CANCELADO', 'ABANDONADO'};
