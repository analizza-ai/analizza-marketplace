import 'dart:async';

import 'package:flutter/material.dart';
import 'package:video_player/video_player.dart';

import 'api.dart';
import 'video_status.dart';

/// Monta o player para o `hlsUrl`; [onError] avisa a tela que a reprodução falhou.
typedef HlsPlayerBuilder = Widget Function(BuildContext context, Uri hlsUrl, VoidCallback onError);

/// Assistir: acompanha o status e, quando PRONTO, pede um playback novo ao back e toca o `hlsUrl`
/// no player nativo (`video_player`). O token vem dentro da URL e vence: é pedido a cada abertura
/// desta tela e nunca guardado.
///
/// Alternativa, se o projeto já usa WebView: abrir o `embedUrl` do mesmo playback com
/// `webview_flutter` (`WebViewController()..loadRequest(playback.embedUrl)`), que traz o player do
/// yeroon com controles prontos — mas a conta precisa liberar a origem, e o `hlsUrl` nativo não.
class VideoPlayerScreen extends StatefulWidget {
  const VideoPlayerScreen({super.key, required this.videoId, this.api, this.playerBuilder});

  final String videoId;
  final YeroonApi? api;

  /// Troca o player (nos testes, um que não precisa de plataforma). Padrão: [HlsPlayer].
  final HlsPlayerBuilder? playerBuilder;

  @override
  State<VideoPlayerScreen> createState() => _VideoPlayerScreenState();
}

class _VideoPlayerScreenState extends State<VideoPlayerScreen> {
  static const _pollEvery = Duration(seconds: 5);
  late final YeroonApi _api = widget.api ?? YeroonApi();
  VideoDetail? _detail;
  bool _error = false;
  Uri? _hlsUrl;
  bool _playerError = false;
  bool _playbackAsked = false;
  Timer? _timer;

  @override
  void initState() {
    super.initState();
    if (!isVideoId(widget.videoId)) {
      _error = true;
      return;
    }
    _load();
    _timer = Timer.periodic(_pollEvery, (_) => _load());
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  Future<void> _load() async {
    try {
      final detail = await _api.getVideo(widget.videoId);
      if (!mounted) return;
      setState(() {
        _detail = detail;
        _error = false;
      });
      if (terminalStatuses.contains(detail.status)) {
        _timer?.cancel();
        _timer = null;
      }
      if (detail.status == 'PRONTO' && !_playbackAsked) {
        _playbackAsked = true;
        await _askPlayback();
      }
    } catch (_) {
      if (mounted) setState(() => _error = true);
    }
  }

  Future<void> _askPlayback() async {
    try {
      final playback = await _api.requestPlayback(widget.videoId);
      if (mounted) setState(() => _hlsUrl = playback.hlsUrl);
    } catch (_) {
      if (mounted) setState(() => _playerError = true);
    }
  }

  @override
  Widget build(BuildContext context) {
    final detail = _detail;
    return Scaffold(
      appBar: AppBar(title: Text(detail?.fileName ?? 'Vídeo')),
      body: detail == null
          ? Center(child: Text(_error ? 'Vídeo não encontrado.' : 'Carregando…'))
          : ListView(
              children: [
                if (detail.status == 'PRONTO' && _hlsUrl != null && !_playerError)
                  (widget.playerBuilder ?? _defaultPlayer)(context, _hlsUrl!, () => setState(() => _playerError = true))
                else if (detail.status == 'FALHOU')
                  Text('Falha no processamento: ${detail.failureReason ?? ''}')
                else if (_playerError)
                  const Text('Não foi possível tocar o vídeo.')
                else
                  Text('${statusLabel(detail.status)} — o vídeo aparece aqui assim que a conversão terminar.'),
                Text('Status: ${statusLabel(detail.status)}'),
              ],
            ),
    );
  }

  static Widget _defaultPlayer(BuildContext context, Uri url, VoidCallback onError) =>
      HlsPlayer(url: url, onError: onError);
}

/// Player nativo do `hlsUrl`, com tocar/pausar. Para controles completos, troque por `chewie`
/// ou pelo player que o projeto já usa.
class HlsPlayer extends StatefulWidget {
  const HlsPlayer({super.key, required this.url, required this.onError});
  final Uri url;
  final VoidCallback onError;

  @override
  State<HlsPlayer> createState() => _HlsPlayerState();
}

class _HlsPlayerState extends State<HlsPlayer> {
  late final VideoPlayerController _controller = VideoPlayerController.networkUrl(
    widget.url,
    formatHint: VideoFormat.hls,
  );

  @override
  void initState() {
    super.initState();
    _controller.addListener(_onChange);
    _controller.initialize().then((_) => _controller.play(), onError: (Object _) => widget.onError());
  }

  void _onChange() {
    if (_controller.value.hasError) widget.onError();
    if (mounted) setState(() {});
  }

  @override
  void dispose() {
    _controller.removeListener(_onChange);
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final value = _controller.value;
    if (!value.isInitialized) return const AspectRatio(aspectRatio: 16 / 9, child: Center(child: CircularProgressIndicator()));
    return Column(
      children: [
        AspectRatio(aspectRatio: value.aspectRatio, child: VideoPlayer(_controller)),
        VideoProgressIndicator(_controller, allowScrubbing: true),
        IconButton(
          tooltip: value.isPlaying ? 'Pausar' : 'Tocar',
          icon: Icon(value.isPlaying ? Icons.pause : Icons.play_arrow),
          onPressed: () => value.isPlaying ? _controller.pause() : _controller.play(),
        ),
      ],
    );
  }
}
