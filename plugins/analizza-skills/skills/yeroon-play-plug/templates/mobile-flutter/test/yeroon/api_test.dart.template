import 'dart:convert';

import 'package:flutter_test/flutter_test.dart';
import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:{flutter-package}/yeroon/api.dart';

const id = '3f1c2e4a-5b6d-4e7f-8a9b-0c1d2e3f4a5b';
const base = 'http://back.test/ctx/api';

http.Response jsonResponse(Object body, [int status = 200]) => http.Response(
      jsonEncode(body),
      status,
      headers: {'content-type': 'application/json; charset=utf-8'},
    );

void main() {
  final calls = <String>[];
  YeroonApi apiWith(http.Response Function(http.Request) respond) {
    calls.clear();
    return YeroonApi(
      baseUrl: base,
      client: MockClient((request) async {
        calls.add('${request.method} ${request.url}');
        return respond(request);
      }),
    );
  }

  test('a base padrão termina no prefixo do back, sem barra no fim', () {
    expect(apiBase.endsWith('{context-path}{api-routes-prefix}'), isTrue);
    expect(apiBase.endsWith('/'), isFalse);
  });

  test('aceita só UUID como videoId', () {
    expect(isVideoId(id), isTrue);
    expect(isVideoId(id.toUpperCase()), isTrue);
    for (final bad in ['', '..', '.', 'a/b', 'v1', '$id/x']) {
      expect(isVideoId(bad), isFalse, reason: bad);
    }
  });

  test('id que não é UUID não chega ao back', () async {
    final api = apiWith((_) => jsonResponse({}));
    expect(() => api.videoUri('..'), throwsA(isA<InvalidVideoIdException>()));
    await expectLater(api.getVideo('..'), throwsA(isA<InvalidVideoIdException>()));
    await expectLater(api.deleteVideo('a/b'), throwsA(isA<InvalidVideoIdException>()));
    await expectLater(api.requestPlayback('x'), throwsA(isA<InvalidVideoIdException>()));
    expect(calls, isEmpty);
  });

  test('lista os vídeos', () async {
    final api = apiWith((_) => jsonResponse({
          'videos': [
            {'videoId': id, 'fileName': 'aula.mp4', 'status': 'PRONTO', 'createdAt': '2026-10-22T00:00:00Z', 'thumbnailUrl': null},
          ],
        }));
    final videos = await api.listVideos();
    expect(videos.single.fileName, 'aula.mp4');
    expect(videos.single.status, 'PRONTO');
    expect(calls, ['GET $base/videos']);
  });

  test('exclui com DELETE', () async {
    final api = apiWith((_) => http.Response('', 204));
    await api.deleteVideo(id);
    expect(calls, ['DELETE $base/videos/$id']);
  });

  test('pede playback com POST e devolve o hlsUrl', () async {
    final api = apiWith((_) => jsonResponse({
          'embedUrl': 'https://play/embed/t',
          'hlsUrl': 'https://play/t/master.m3u8',
          'expiresAt': '2026-10-22T06:00:00Z',
        }));
    final playback = await api.requestPlayback(id);
    expect(playback.hlsUrl, Uri.parse('https://play/t/master.m3u8'));
    expect(calls, ['POST $base/videos/$id/playback']);
  });

  test('erro vira YeroonApiException com status e mensagens', () async {
    final api = apiWith((_) => http.Response(
          jsonEncode({
            'errors': [
              {'code': 'video.deletable', 'message': 'Ainda processando.'},
            ],
          }),
          422,
          headers: {'content-type': 'application/problem+json'},
        ));
    final err = await api.deleteVideo(id).then<Object?>((_) => null, onError: (Object e) => e);
    expect(err, isA<YeroonApiException>());
    expect((err as YeroonApiException).status, 422);
    expect(err.messages, ['Ainda processando.']);
  });
}
