import 'dart:convert';
import 'dart:io';
import 'dart:typed_data';

import 'package:flutter_test/flutter_test.dart';
import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:{flutter-package}/yeroon/api.dart';
import 'package:{flutter-package}/yeroon/upload.dart';

const id = '3f1c2e4a-5b6d-4e7f-8a9b-0c1d2e3f4a5b';
const base = 'http://back.test/api';
const noWait = [Duration.zero, Duration.zero, Duration.zero];

class Call {
  Call(this.method, this.url, this.body, {this.via = '', this.headers = const {}});
  final String method;
  final String url;
  final Object? body;

  /// Por qual cliente a chamada saiu: `back` ou `storage`.
  final String via;
  final Map<String, String> headers;
}

/// O que o projeto faz no app: um cliente do back que injeta a autenticação do app.
class AuthClient extends http.BaseClient {
  AuthClient(this._inner);
  final http.Client _inner;
  @override
  Future<http.StreamedResponse> send(http.BaseRequest request) {
    request.headers['Authorization'] = 'Bearer app-token';
    request.headers['Cookie'] = 's=1';
    return _inner.send(request);
  }
}

http.Response jsonResponse(Object body, [int status = 200]) =>
    http.Response(jsonEncode(body), status, headers: {'content-type': 'application/json'});

/// Back e storage falsos. `putHook` pode trocar a resposta do PUT de uma parte.
class FakeBack {
  FakeBack({
    this.partSize = 10,
    this.partCount = 3,
    this.videoId = id,
    this.existingParts = const [],
    this.partsStatus,
    this.initResponse,
    this.putHook,
  });

  final int partSize;
  final int partCount;
  final String videoId;
  final List<int> existingParts;
  final int? partsStatus;
  final http.Response? initResponse;
  final http.Response? Function(int partNumber, int attempt)? putHook;
  final calls = <Call>[];
  final putBodies = <int, List<int>>{};
  final _attempts = <int, int>{};

  YeroonApi get api => YeroonApi(baseUrl: base, client: MockClient((r) => _handle(r, 'back')));

  /// Back com a autenticação do app injetada no cliente.
  YeroonApi get authedApi => YeroonApi(baseUrl: base, client: AuthClient(MockClient((r) => _handle(r, 'back'))));

  /// Cliente do storage (as URLs assinadas).
  http.Client get storage => MockClient((r) => _handle(r, 'storage'));

  String get _video => '$base/videos/${Uri.encodeComponent(videoId)}';

  Future<http.Response> _handle(http.Request r, String via) async {
    final url = r.url.toString();
    final body = r.headers['content-type']?.startsWith('application/json') == true ? jsonDecode(r.body) : null;
    calls.add(Call(r.method, url, body, via: via, headers: {
      for (final e in r.headers.entries) e.key.toLowerCase(): e.value,
    }));
    if (r.method == 'POST' && url == '$base/videos/uploads') {
      return initResponse ?? jsonResponse({'videoId': videoId, 'partSizeBytes': partSize, 'partCount': partCount}, 201);
    }
    if (r.method == 'GET' && url == '$_video/upload/parts') {
      if (partsStatus != null) return jsonResponse({'title': 'x'}, partsStatus!);
      return jsonResponse({
        'parts': [
          for (final n in existingParts) {'partNumber': n, 'etag': '"e$n"', 'sizeBytes': partSize},
        ],
      });
    }
    if (r.method == 'POST' && url == '$_video/upload/part-urls') {
      final numbers = ((body as Map)['partNumbers'] as List).cast<int>();
      return jsonResponse({
        'urls': [
          for (final n in numbers) {'partNumber': n, 'url': 'https://storage.test/put/$n'},
        ],
      });
    }
    if (r.method == 'PUT') {
      final n = int.parse(r.url.pathSegments.last);
      final attempt = (_attempts[n] ?? 0) + 1;
      _attempts[n] = attempt;
      putBodies[n] = r.bodyBytes;
      final custom = putHook?.call(n, attempt);
      if (custom != null) return custom;
      return http.Response('', 200, headers: {'etag': '"e$n"'});
    }
    if (r.method == 'POST' && url == '$_video/upload/complete') {
      return jsonResponse({'videoId': videoId, 'status': 'ENVIADO'});
    }
    if (r.method == 'DELETE' && url == '$_video/upload') return http.Response('', 204);
    throw StateError('chamada inesperada ${r.method} $url');
  }
}

void main() {
  late Directory dir;
  late File file;

  setUp(() async {
    dir = await Directory.systemTemp.createTemp('yeroon_upload_test');
    file = File('${dir.path}/a.mp4');
    // 25 bytes: 0, 1, 2, ... — dá para conferir a faixa de cada parte.
    await file.writeAsBytes(List.generate(25, (i) => i));
  });

  tearDown(() => dir.delete(recursive: true));

  const key = 'upload:a.mp4:25';

  test('lê as partes por faixa, envia e devolve o videoId', () async {
    final back = FakeBack();
    final store = MemoryPendingUploadStore();
    final progress = <List<int>>[];
    final videoId = await uploadVideo(
      file,
      (sent, total) => progress.add([sent, total]),
      api: back.api,
      storageClient: back.storage,
      store: store,
      retryDelays: noWait,
    );
    expect(videoId, id);
    expect(back.calls.first.body, {'fileName': 'a.mp4', 'contentType': 'video/mp4', 'sizeBytes': 25});
    expect(back.putBodies[1], List.generate(10, (i) => i));
    expect(back.putBodies[2], List.generate(10, (i) => 10 + i));
    expect(back.putBodies[3], List.generate(5, (i) => 20 + i));
    final complete = back.calls.firstWhere((c) => c.url.endsWith('/upload/complete'));
    expect(complete.body, {
      'parts': [
        {'partNumber': 1, 'etag': '"e1"'},
        {'partNumber': 2, 'etag': '"e2"'},
        {'partNumber': 3, 'etag': '"e3"'},
      ],
    });
    expect(progress.last, [3, 3]);
    expect(store.isEmpty, isTrue);
  });

  test('PUT das partes nunca usa o cliente autenticado do back', () async {
    final back = FakeBack(putHook: (n, attempt) => n == 2 && attempt == 1 ? http.Response('', 500) : null);
    await uploadVideo(file, null,
        api: back.authedApi, storageClient: back.storage, store: MemoryPendingUploadStore(), retryDelays: noWait);
    expect(back.calls.where((c) => c.via == 'back' && c.method == 'PUT'), isEmpty);
    final puts = back.calls.where((c) => c.method == 'PUT').toList();
    expect(puts.length, 4); // 3 partes + 1 nova tentativa
    for (final put in puts) {
      expect(put.via, 'storage');
      expect(put.headers.containsKey('authorization'), isFalse);
      expect(put.headers.containsKey('cookie'), isFalse);
    }
    final backCalls = back.calls.where((c) => c.via == 'back').toList();
    expect(backCalls, isNotEmpty);
    for (final call in backCalls) {
      expect(call.headers['authorization'], 'Bearer app-token');
    }
  });

  test('sem storageClient, o PUT usa um http.Client novo e não o do back', () async {
    final back = FakeBack();
    await http.runWithClient(
      () => uploadVideo(file, null, api: back.authedApi, store: MemoryPendingUploadStore(), retryDelays: noWait),
      () => back.storage,
    );
    final puts = back.calls.where((c) => c.method == 'PUT').toList();
    expect(puts.length, 3);
    for (final put in puts) {
      expect(put.via, 'storage');
      expect(put.headers.containsKey('authorization'), isFalse);
    }
  });

  test('pede no máximo 20 URLs por chamada', () async {
    await file.writeAsBytes(List.filled(45, 7));
    final back = FakeBack(partSize: 1, partCount: 45);
    await uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore(), retryDelays: noWait);
    final batches = back.calls
        .where((c) => c.url.endsWith('/part-urls'))
        .map((c) => ((c.body as Map)['partNumbers'] as List).length)
        .toList();
    expect(batches, [20, 20, 5]);
  });

  test('retoma enviando só as partes que faltam', () async {
    final back = FakeBack(existingParts: [1, 2]);
    final plan = jsonEncode({'partSize': 10, 'fingerprint': await fileFingerprint(file)});
    final store = MemoryPendingUploadStore({key: id, '$key:plan': plan});
    await uploadVideo(file, null, api: back.api, storageClient: back.storage, store: store, retryDelays: noWait);
    expect(back.calls.any((c) => c.url == '$base/videos/uploads'), isFalse);
    expect(back.calls.where((c) => c.method == 'PUT').map((c) => c.url), ['https://storage.test/put/3']);
    final asked = back.calls.firstWhere((c) => c.url.endsWith('/part-urls')).body;
    expect(asked, {
      'partNumbers': [3],
    });
    final complete = back.calls.firstWhere((c) => c.url.endsWith('/upload/complete'));
    expect(((complete.body as Map)['parts'] as List).map((p) => (p as Map)['partNumber']), [1, 2, 3]);
  });

  test('upload guardado que não está mais pendente começa do zero', () async {
    final back = FakeBack(partsStatus: 422);
    final plan = jsonEncode({'partSize': 10, 'fingerprint': await fileFingerprint(file)});
    await uploadVideo(file, null,
        api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore({key: id, '$key:plan': plan}), retryDelays: noWait);
    expect(back.calls.any((c) => c.method == 'GET' && c.url.endsWith('/upload/parts')), isTrue);
    expect(back.calls.any((c) => c.url == '$base/videos/uploads'), isTrue);
  });

  test('mesmo nome e tamanho com conteúdo diferente não retoma', () async {
    final back = FakeBack(existingParts: [1, 2]);
    final plan = jsonEncode({'partSize': 10, 'fingerprint': '25:00000000'});
    await uploadVideo(file, null,
        api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore({key: id, '$key:plan': plan}), retryDelays: noWait);
    expect(back.calls.any((c) => c.url.endsWith('/upload/parts')), isFalse);
    expect(back.calls.any((c) => c.method == 'DELETE' && c.url == '$base/videos/$id/upload'), isTrue);
    expect(back.calls.any((c) => c.url == '$base/videos/uploads'), isTrue);
    expect(back.calls.where((c) => c.method == 'PUT').length, 3);
  });

  test('plano guardado sem impressão digital não retoma', () async {
    final back = FakeBack(existingParts: [1]);
    final plan = jsonEncode({'partSize': 10});
    await uploadVideo(file, null,
        api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore({key: id, '$key:plan': plan}), retryDelays: noWait);
    expect(back.calls.any((c) => c.url.endsWith('/upload/parts')), isFalse);
    expect(back.calls.any((c) => c.url == '$base/videos/uploads'), isTrue);
  });

  test('leitura curta falha a parte antes do PUT', () async {
    final back = FakeBack();
    Future<Uint8List> shortReader(File f, int start, int length) async =>
        Uint8List(start == 10 ? length - 1 : length);
    await expectLater(
      uploadVideo(file, null,
          api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore(), reader: shortReader, retryDelays: noWait),
      throwsA(predicate((e) => e.toString().contains('Parte 2: lidos 9 de 10 bytes do arquivo'))),
    );
    expect(back.calls.any((c) => c.method == 'PUT' && c.url.endsWith('/2')), isFalse);
    expect(back.calls.any((c) => c.url.endsWith('/upload/complete')), isFalse);
  });

  test('id guardado que não é UUID é descartado sem chamar o back', () async {
    final back = FakeBack();
    await uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore({key: '..'}), retryDelays: noWait);
    expect(back.calls.first.url, '$base/videos/uploads');
  });

  test('videoId do back que não é UUID para o envio', () async {
    final back = FakeBack(videoId: 'a/b');
    await expectLater(
      uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore(), retryDelays: noWait),
      throwsA(isA<InvalidVideoIdException>()),
    );
    expect(back.calls.any((c) => c.url.endsWith('/part-urls')), isFalse);
  });

  test('início recusado com 422 traz as mensagens do servidor', () async {
    final back = FakeBack(
      initResponse: jsonResponse({
        'errors': [
          {'code': 'trial.video-limit', 'message': 'Limite de vídeos atingido.'},
        ],
      }, 422),
    );
    final err = await uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore())
        .then<Object?>((_) => null, onError: (Object e) => e);
    expect(err, isA<UploadRejectedException>());
    expect((err as UploadRejectedException).message, 'Limite de vídeos atingido.');
    expect(back.calls.any((c) => c.url.endsWith('/part-urls')), isFalse);
  });

  test('tenta de novo uma parte que falhou', () async {
    final back = FakeBack(putHook: (n, attempt) => n == 2 && attempt == 1 ? http.Response('', 500) : null);
    await uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore(), retryDelays: noWait);
    expect(back.calls.where((c) => c.method == 'PUT' && c.url.endsWith('/2')).length, 2);
    expect(back.calls.any((c) => c.url.endsWith('/upload/complete')), isTrue);
  });

  test('parte sem ETag falha e não completa', () async {
    final back = FakeBack(putHook: (n, _) => n == 1 ? http.Response('', 200) : null);
    await expectLater(
      uploadVideo(file, null, api: back.api, storageClient: back.storage, store: MemoryPendingUploadStore(), retryDelays: noWait),
      throwsA(predicate((e) => e.toString().contains('ETag'))),
    );
    expect(back.calls.where((c) => c.method == 'PUT' && c.url.endsWith('/1')).length, noWait.length + 1);
    expect(back.calls.any((c) => c.url.endsWith('/upload/complete')), isFalse);
  });

  test('cancelar aborta no back e apaga o pendente', () async {
    final token = UploadCancelToken();
    final back = FakeBack(putHook: (_, _) {
      token.cancel();
      return null;
    });
    final store = MemoryPendingUploadStore();
    await expectLater(
      uploadVideo(file, null, api: back.api, storageClient: back.storage, store: store, cancelToken: token, retryDelays: noWait),
      throwsA(isA<UploadCancelledException>()),
    );
    expect(back.calls.any((c) => c.method == 'DELETE' && c.url == '$base/videos/$id/upload'), isTrue);
    expect(back.calls.any((c) => c.url.endsWith('/upload/complete')), isFalse);
    expect(store.isEmpty, isTrue);
  });
}
