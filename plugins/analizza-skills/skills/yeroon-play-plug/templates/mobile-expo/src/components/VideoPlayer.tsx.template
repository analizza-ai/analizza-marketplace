import { useEffect, useState } from "react";
import { Text, View } from "react-native";
import { useVideoPlayer, VideoView } from "expo-video";
import { getVideo, isVideoId, requestPlayback, type VideoDetail } from "@/lib/api";
import { statusLabel } from "@/lib/videoStatus";

// Estados finais: nada mais muda, então a consulta para.
const TERMINAL = ["PRONTO", "FALHOU", "CANCELADO", "ABANDONADO"];
const POLL_MS = 5000;

/**
 * Acompanha o status do vídeo e, quando PRONTO, pede um playback novo ao back e toca o `hlsUrl` no
 * player nativo (`expo-video`). O token vem dentro da URL e vence: é pedido a cada abertura da tela
 * e nunca guardado.
 */
export function VideoPlayer({ id }: { id: string }) {
  const validId = isVideoId(id);
  const [detail, setDetail] = useState<VideoDetail | null>(null);
  const [error, setError] = useState(!validId);
  const [hlsUrl, setHlsUrl] = useState<string | null>(null);
  const [playerError, setPlayerError] = useState(false);
  const finished = detail !== null && TERMINAL.includes(detail.status);
  const ready = detail?.status === "PRONTO";

  useEffect(() => {
    if (!validId || finished) return;
    let cancelled = false;
    const load = async () => {
      try {
        const body = await getVideo(id);
        if (!cancelled) {
          setDetail(body);
          setError(false);
        }
      } catch {
        if (!cancelled) setError(true);
      }
    };
    void load();
    const timer = setInterval(load, POLL_MS);
    return () => {
      cancelled = true;
      clearInterval(timer);
    };
  }, [id, validId, finished]);

  useEffect(() => {
    if (!ready) return;
    let cancelled = false;
    (async () => {
      try {
        const playback = await requestPlayback(id);
        if (!cancelled) setHlsUrl(playback.hlsUrl);
      } catch {
        if (!cancelled) setPlayerError(true);
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [id, ready]);

  if (!detail) {
    return <Text>{error ? "Vídeo não encontrado." : "Carregando…"}</Text>;
  }
  return (
    <View accessibilityLabel="Vídeo em reprodução">
      {ready && hlsUrl && !playerError ? (
        <HlsPlayer url={ hlsUrl } onError={() => setPlayerError(true)} />
      ) : detail.status === "FALHOU" ? (
        <Text role="alert">Falha no processamento: { detail.failureReason }</Text>
      ) : playerError ? (
        <Text role="alert">Não foi possível tocar o vídeo.</Text>
      ) : (
        <Text>{statusLabel(detail.status)} — o vídeo aparece aqui assim que a conversão terminar.</Text>
      )}
      <Text accessibilityRole="header">{ detail.fileName }</Text>
      <Text>Status: {statusLabel(detail.status)}</Text>
    </View>
  );
}

/** Montado só quando o `hlsUrl` já chegou: `useVideoPlayer` cria o player com a fonte certa. */
function HlsPlayer({ url, onError }: { url: string; onError: () => void }) {
  const player = useVideoPlayer(url, (p) => {
    p.play();
  });
  useEffect(() => {
    const sub = player.addListener("statusChange", ({ status }) => {
      if (status === "error") onError();
    });
    return () => sub.remove();
  }, [player, onError]);
  return <VideoView player={ player } style={{ width: "100%", aspectRatio: 16 / 9 }} nativeControls allowsPictureInPicture />;
}
