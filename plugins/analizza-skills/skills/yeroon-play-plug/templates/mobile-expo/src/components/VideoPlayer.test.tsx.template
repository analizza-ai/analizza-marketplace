import { render, screen, waitFor } from "@testing-library/react-native";
import { API_BASE } from "@/lib/api";
import { VideoPlayer } from "@/components/VideoPlayer";

// O player nativo não existe no Jest: o dublê anota a fonte pedida e desenha uma View.
jest.mock("expo-video", () => {
  const { View } = require("react-native");
  return {
    useVideoPlayer: jest.fn((source: string) => ({
      source,
      play: jest.fn(),
      addListener: jest.fn(() => ({ remove: jest.fn() })),
    })),
    VideoView: ({ player }: { player: { source: string } }) => <View testID="video-view" accessibilityHint={player.source} />,
  };
});

const ID = "3f1c2e4a-5b6d-4e7f-8a9b-0c1d2e3f4a5b";
const HLS = "https://play/api/play/tok/master.m3u8";

const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), { status, headers: { "content-type": "application/json" } });

let calls: { url: string; method: string }[] = [];

function backWith(detail: { status: string; failureReason?: string | null }, playbackStatus = 200) {
  calls = [];
  globalThis.fetch = jest.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
    const url = String(input);
    const method = init?.method ?? "GET";
    calls.push({ url, method });
    if (method === "GET" && url === `${API_BASE}/videos/${ID}`) {
      return json({ videoId: ID, fileName: "aula.mp4", failureReason: null, ...detail });
    }
    if (method === "POST" && url === `${API_BASE}/videos/${ID}/playback`) {
      if (playbackStatus !== 200) return json({ title: "x" }, playbackStatus);
      return json({ embedUrl: "https://play/embed/tok", hlsUrl: HLS, expiresAt: "2026-10-22T06:00:00Z" });
    }
    throw new Error(`chamada inesperada ${method} ${url}`);
  }) as typeof fetch;
}

describe("VideoPlayer", () => {
  test("prontoPedePlaybackUmaVezETocaOHlsUrl", async () => {
    backWith({ status: "PRONTO" });
    await render(<VideoPlayer id={ ID } />);
    const view = await screen.findByTestId("video-view");
    expect(view.props.accessibilityHint).toBe(HLS);
    expect(calls.filter((c) => c.url.endsWith("/playback"))).toEqual([
      { url: `${API_BASE}/videos/${ID}/playback`, method: "POST" },
    ]);
    expect(screen.getByText("aula.mp4")).toBeTruthy();
  });

  test("aindaConvertendoMostraOStatusSemPedirPlayback", async () => {
    backWith({ status: "PROCESSANDO" });
    await render(<VideoPlayer id={ ID } />);
    expect(await screen.findByText("Status: Convertendo")).toBeTruthy();
    expect(calls.some((c) => c.url.endsWith("/playback"))).toBe(false);
    expect(screen.queryByTestId("video-view")).toBeNull();
  });

  test("falhaMostraOMotivo", async () => {
    backWith({ status: "FALHOU", failureReason: "Codec não suportado" });
    await render(<VideoPlayer id={ ID } />);
    expect(await screen.findByText(/Codec não suportado/)).toBeTruthy();
  });

  test("playbackRecusadoMostraErro", async () => {
    backWith({ status: "PRONTO" }, 409);
    await render(<VideoPlayer id={ ID } />);
    expect(await screen.findByText("Não foi possível tocar o vídeo.")).toBeTruthy();
  });

  test("idQueNaoEUuidNaoChamaOBack", async () => {
    backWith({ status: "PRONTO" });
    await render(<VideoPlayer id=".." />);
    expect(await screen.findByText("Vídeo não encontrado.")).toBeTruthy();
    await waitFor(() => expect(calls).toHaveLength(0));
  });
});
