import { Stack } from "expo-router";

/** Pilha das telas de vídeo: a lista em `/videos` e o player em `/videos/<id>`. */
export default function VideosLayout() {
  return (
    <Stack>
      <Stack.Screen name="index" options={{ title: "Vídeos" }} />
      <Stack.Screen name="[id]" options={{ title: "Vídeo" }} />
    </Stack>
  );
}
