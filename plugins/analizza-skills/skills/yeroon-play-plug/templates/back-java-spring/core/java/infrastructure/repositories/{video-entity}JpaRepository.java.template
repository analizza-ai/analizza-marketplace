package {base-package}.infrastructure.repositories;

import java.util.Set;
import java.util.UUID;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;

interface {video-entity}JpaRepository extends JpaRepository<{video-entity}JpaEntity, UUID> {
    @Query("select v.id from {video-entity}JpaEntity v")
    Set<UUID> findAllIds();
}
