package {base-package}.infrastructure.data.anticorruptionLayer.yeroon;

import java.util.List;

/** 422 da /v1: regra quebrada. Os errors[] são repassados ao chamador. */
public class YeroonRejectedException extends RuntimeException {
    private final List<YeroonError> errors;

    public YeroonRejectedException(List<YeroonError> errors) {
        super("A /v1 do yeroon play recusou a requisição.");
        this.errors = List.copyOf(errors);
    }

    public List<YeroonError> errors() {
        return errors;
    }
}
