package {base-package}.application.video.getVideo;

import {base-package}.domain.{video-entity}NotFoundException;
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonVideo;
import org.springframework.stereotype.Component;

@Component
public class GetVideoHandler {
    private final YeroonClient yeroon;
    private final {video-entity}Repository videos;

    public GetVideoHandler(YeroonClient yeroon, {video-entity}Repository videos) {
        this.yeroon = yeroon;
        this.videos = videos;
    }

    public GetVideoResult handle(GetVideoQuery query) {
        if (!videos.existsById(query.videoId())) throw new {video-entity}NotFoundException();
        YeroonVideo v = yeroon.get(query.videoId());
        return new GetVideoResult(
                v.videoId(),
                v.fileName(),
                v.status(),
                v.failureReason(),
                v.renditions(),
                v.thumbnailUrl() == null ? null : v.thumbnailUrl().toString());
    }
}
