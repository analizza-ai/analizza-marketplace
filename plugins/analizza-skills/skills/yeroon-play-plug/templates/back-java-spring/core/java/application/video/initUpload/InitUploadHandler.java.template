package {base-package}.application.video.initUpload;

import {base-package}.domain.{video-entity};
import {base-package}.domain.{video-entity}RequestInvalidException;
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonUpload;
import java.time.Instant;
import org.springframework.stereotype.Component;

@Component
public class InitUploadHandler {
    private final YeroonClient yeroon;
    private final {video-entity}Repository videos;

    public InitUploadHandler(YeroonClient yeroon, {video-entity}Repository videos) {
        this.yeroon = yeroon;
        this.videos = videos;
    }

    public InitUploadResult handle(InitUploadCommand command) {
        {video-entity}RequestInvalidException.requireFields(
                "fileName", command.fileName(),
                "contentType", command.contentType(),
                "sizeBytes", command.sizeBytes());
        YeroonUpload upload = yeroon.initUpload(command.fileName(), command.contentType(), command.sizeBytes());
        // Só depois que a /v1 aceitou: uma recusa (422) não deixa linha órfã.
        videos.save({video-entity}.register(upload.videoId(), Instant.now()));
        return new InitUploadResult(upload.videoId(), upload.partSizeBytes(), upload.partCount());
    }
}
