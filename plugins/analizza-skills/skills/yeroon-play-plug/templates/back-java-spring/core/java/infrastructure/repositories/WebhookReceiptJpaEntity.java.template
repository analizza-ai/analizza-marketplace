package {base-package}.infrastructure.repositories;

import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import java.time.Instant;
import java.util.UUID;
import org.springframework.data.domain.Persistable;

/**
 * Recibo de um aviso do webhook. Persistable com isNew sempre true: o save vira
 * INSERT puro (sem SELECT antes), e um deliveryId repetido estoura a chave
 * primária — é assim que o dedupe funciona em qualquer banco.
 */
@Entity
@Table(name = "{webhook-table}")
public class WebhookReceiptJpaEntity implements Persistable<String> {
    @Id
    @Column(name = "delivery_id")
    private String deliveryId;

    @Column(name = "event_type", nullable = false)
    private String eventType;

    @Column(name = "video_id")
    private UUID videoId;

    @Column(name = "received_at", nullable = false)
    private Instant receivedAt;

    protected WebhookReceiptJpaEntity() {
    }

    WebhookReceiptJpaEntity(String deliveryId, String eventType, UUID videoId, Instant receivedAt) {
        this.deliveryId = deliveryId;
        this.eventType = eventType;
        this.videoId = videoId;
        this.receivedAt = receivedAt;
    }

    @Override
    public String getId() {
        return deliveryId;
    }

    @Override
    public boolean isNew() {
        return true;
    }
}
