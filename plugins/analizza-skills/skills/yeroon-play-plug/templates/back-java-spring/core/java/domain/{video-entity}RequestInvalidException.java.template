package {base-package}.domain;

import java.util.List;

/** Campos obrigatórios ausentes na entrada: 422 com um errors[] por campo, sem chamar a /v1. */
public class {video-entity}RequestInvalidException extends RuntimeException {
    private final List<String> missingFields;

    public {video-entity}RequestInvalidException(List<String> missingFields) {
        super("Campos obrigatórios ausentes: " + missingFields);
        this.missingFields = List.copyOf(missingFields);
    }

    public List<String> missingFields() {
        return missingFields;
    }

    /** Lança se algum valor for nulo, texto em branco ou lista vazia. Pares (campo, valor). */
    public static void requireFields(Object... fieldsAndValues) {
        java.util.ArrayList<String> missing = new java.util.ArrayList<>();
        for (int i = 0; i < fieldsAndValues.length; i += 2) {
            Object value = fieldsAndValues[i + 1];
            boolean blank = value == null
                    || (value instanceof CharSequence text && text.toString().isBlank())
                    || (value instanceof java.util.Collection<?> list && list.isEmpty());
            if (blank) {
                missing.add((String) fieldsAndValues[i]);
            }
        }
        if (!missing.isEmpty()) {
            throw new {video-entity}RequestInvalidException(missing);
        }
    }
}
