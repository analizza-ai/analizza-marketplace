package {base-package}.application.video.completeUpload;

import {base-package}.domain.{video-entity}RequestInvalidException;
import {base-package}.domain.{video-entity}NotFoundException;
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonCompleted;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonPart;
import org.springframework.stereotype.Component;

@Component
public class CompleteUploadHandler {
    private final YeroonClient yeroon;
    private final {video-entity}Repository videos;

    public CompleteUploadHandler(YeroonClient yeroon, {video-entity}Repository videos) {
        this.yeroon = yeroon;
        this.videos = videos;
    }

    public CompleteUploadResult handle(CompleteUploadCommand command) {
        {video-entity}RequestInvalidException.requireFields("parts", command.parts());
        if (!videos.existsById(command.videoId())) throw new {video-entity}NotFoundException();
        YeroonCompleted completed = yeroon.complete(command.videoId(), command.parts().stream()
                .map(p -> new YeroonPart(p.partNumber(), p.etag()))
                .toList());
        return new CompleteUploadResult(completed.videoId(), completed.status());
    }
}
