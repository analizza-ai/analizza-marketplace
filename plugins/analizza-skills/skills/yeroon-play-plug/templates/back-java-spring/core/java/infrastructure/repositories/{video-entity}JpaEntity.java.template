package {base-package}.infrastructure.repositories;

import {base-package}.domain.{video-entity};
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.Table;
import java.time.Instant;
import java.util.UUID;

@Entity
@Table(name = "{video-table}")
public class {video-entity}JpaEntity {
    @Id
    private UUID id;

    @Column(name = "created_at", nullable = false)
    private Instant createdAt;

    protected {video-entity}JpaEntity() {
    }

    {video-entity}JpaEntity(UUID id, Instant createdAt) {
        this.id = id;
        this.createdAt = createdAt;
    }

    static {video-entity}JpaEntity fromDomain({video-entity} video) {
        return new {video-entity}JpaEntity(video.getId(), video.getCreatedAt());
    }

    {video-entity} toDomain() {
        return {video-entity}.restore(id, createdAt);
    }
}
