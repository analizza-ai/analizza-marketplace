package {base-package}.presenter.routes.video;

import static org.junit.jupiter.api.Assertions.*;

import {base-package}.domain.{video-entity};
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*;
import {base-package}.support.FakeYeroonClient;
import {base-package}.support.YeroonIntegrationTest;
import java.net.URI;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;

class PresignUploadPartsRouteIT extends YeroonIntegrationTest {

    @Autowired
    private {video-entity}Repository videos;

    @Test
    void devolveUmaUrlAssinadaPorParte() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));

        api.post().uri("{api-routes-prefix}/videos/{id}/upload/part-urls", id).contentType(MediaType.APPLICATION_JSON)
                .body(Map.of("partNumbers", List.of(1, 2)))
                .exchange().expectStatus().isOk()
                .expectBody()
                .jsonPath("$.urls[0].partNumber").isEqualTo(1)
                .jsonPath("$.urls[1].url").isEqualTo("https://storage.example/" + id + "/2");
    }

    @Test
    void idForaDaTabelaRetorna404SemChamarAV1() {
        UUID id = UUID.randomUUID();

        var body = api.post().uri("{api-routes-prefix}/videos/{id}/upload/part-urls", id)
                .contentType(MediaType.APPLICATION_JSON)
                .body(Map.of("partNumbers", List.of(1)))
                .exchange().expectStatus().isNotFound()
                .expectBody().returnResult().getResponseBody();
        assertEquals(0, yeroon.calls());
        assertFalse(new String(body).contains(id.toString()));
    }

    @Test
    void partNumbersAusenteVira422() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));

        api.post().uri("{api-routes-prefix}/videos/{id}/upload/part-urls", id).contentType(MediaType.APPLICATION_JSON)
                .body(Map.of())
                .exchange().expectStatus().isEqualTo(422)
                .expectBody().jsonPath("$.errors[0].code").isEqualTo("required.partNumbers");
    }
}
