package {base-package}.presenter.routes.video;

import static org.junit.jupiter.api.Assertions.*;

import {base-package}.domain.{video-entity};
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*;
import {base-package}.support.FakeYeroonClient;
import {base-package}.support.YeroonIntegrationTest;
import java.net.URI;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;

class CompleteUploadRouteIT extends YeroonIntegrationTest {

    @Autowired
    private {video-entity}Repository videos;

    @Test
    void completaOUpload() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));

        api.post().uri("{api-routes-prefix}/videos/{id}/upload/complete", id).contentType(MediaType.APPLICATION_JSON)
                .body(Map.of("parts", List.of(Map.of("partNumber", 1, "etag", "\"e\""))))
                .exchange().expectStatus().isOk()
                .expectBody()
                .jsonPath("$.videoId").isEqualTo(id.toString())
                .jsonPath("$.status").isEqualTo("ENVIADO");
    }

    @Test
    void idForaDaTabelaRetorna404SemChamarAV1() {
        UUID id = UUID.randomUUID();

        api.post().uri("{api-routes-prefix}/videos/{id}/upload/complete", id).contentType(MediaType.APPLICATION_JSON)
                .body(Map.of("parts", List.of(Map.of("partNumber", 1, "etag", "\"e\""))))
                .exchange().expectStatus().isNotFound();
        assertEquals(0, yeroon.calls());
    }

    @Test
    void partsAusenteVira422() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));

        api.post().uri("{api-routes-prefix}/videos/{id}/upload/complete", id).contentType(MediaType.APPLICATION_JSON)
                .body(Map.of())
                .exchange().expectStatus().isEqualTo(422)
                .expectBody().jsonPath("$.errors[0].code").isEqualTo("required.parts");
    }
}
