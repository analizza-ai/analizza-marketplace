package {base-package}.presenter.configuration.security;

import java.nio.charset.StandardCharsets;
import java.security.GeneralSecurityException;
import java.security.MessageDigest;
import java.time.Instant;
import java.util.HexFormat;
import javax.crypto.Mac;
import javax.crypto.spec.SecretKeySpec;

/**
 * Confere o X-Yeroon-Signature: {@code t=<epoch>,v1=hex(HMAC-SHA256(segredo, "<epoch>." + corpo bruto))}.
 * O corpo entra como bytes, exatamente como chegou: re-serializar o JSON mudaria a
 * assinatura. Comparação em tempo constante; recusa epoch fora de ±5 min e
 * recusa tudo quando não há segredo configurado.
 */
public final class YeroonWebhookSignature {

    private static final long TOLERANCE_SECONDS = 300;

    private YeroonWebhookSignature() {
    }

    public static boolean verify(String secret, String header, byte[] rawBody, Instant now) {
        if (secret == null || secret.isBlank() || header == null || rawBody == null) return false;
        String t = null;
        String v1 = null;
        for (String part : header.split(",")) {
            String p = part.trim();
            if (p.startsWith("t=")) t = p.substring(2);
            else if (p.startsWith("v1=")) v1 = p.substring(3);
        }
        if (t == null || v1 == null) return false;
        long epoch;
        byte[] provided;
        try {
            epoch = Long.parseLong(t);
            provided = HexFormat.of().parseHex(v1);
        } catch (IllegalArgumentException e) {
            return false;
        }
        if (Math.abs(now.getEpochSecond() - epoch) > TOLERANCE_SECONDS) return false;
        try {
            Mac mac = Mac.getInstance("HmacSHA256");
            mac.init(new SecretKeySpec(secret.getBytes(StandardCharsets.UTF_8), "HmacSHA256"));
            mac.update((epoch + ".").getBytes(StandardCharsets.UTF_8));
            byte[] expected = mac.doFinal(rawBody);
            return MessageDigest.isEqual(expected, provided);
        } catch (GeneralSecurityException e) {
            return false;
        }
    }
}
