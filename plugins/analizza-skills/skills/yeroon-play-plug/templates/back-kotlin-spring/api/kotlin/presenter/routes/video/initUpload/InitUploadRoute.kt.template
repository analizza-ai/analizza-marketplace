package {base-package}.presenter.routes.video.initUpload

import {base-package}.application.video.initUpload.InitUploadCommand
import {base-package}.application.video.initUpload.InitUploadHandler
import {base-package}.application.video.initUpload.InitUploadResult
import org.springframework.http.HttpStatus
import org.springframework.web.bind.annotation.PostMapping
import org.springframework.web.bind.annotation.RequestBody
import org.springframework.web.bind.annotation.ResponseStatus
import org.springframework.web.bind.annotation.RestController

@RestController
class InitUploadRoute(private val handler: InitUploadHandler) {

    /** Campos anuláveis: um campo ausente vira 422 no handler, não 400 do Jackson. */
    data class InitUploadRequest(val fileName: String? = null, val contentType: String? = null, val sizeBytes: Long? = null)

    @PostMapping("{api-routes-prefix}/videos/uploads")
    @ResponseStatus(HttpStatus.CREATED)
    fun handle(@RequestBody request: InitUploadRequest): InitUploadResult =
        handler.handle(InitUploadCommand(request.fileName, request.contentType, request.sizeBytes))
}
