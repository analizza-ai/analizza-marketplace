package {base-package}.presenter.routes.video.listUploadedParts

import {base-package}.application.video.listUploadedParts.ListUploadedPartsHandler
import {base-package}.application.video.listUploadedParts.ListUploadedPartsQuery
import {base-package}.application.video.listUploadedParts.ListUploadedPartsResult
import java.util.UUID
import org.springframework.web.bind.annotation.GetMapping
import org.springframework.web.bind.annotation.PathVariable
import org.springframework.web.bind.annotation.RestController

@RestController
class ListUploadedPartsRoute(private val handler: ListUploadedPartsHandler) {

    @GetMapping("{api-routes-prefix}/videos/{id}/upload/parts")
    fun handle(@PathVariable id: UUID): ListUploadedPartsResult = handler.handle(ListUploadedPartsQuery(id))
}
