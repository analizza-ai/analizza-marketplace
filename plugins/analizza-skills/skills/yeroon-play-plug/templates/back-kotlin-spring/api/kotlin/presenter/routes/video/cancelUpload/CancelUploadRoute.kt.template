package {base-package}.presenter.routes.video.cancelUpload

import {base-package}.application.video.cancelUpload.CancelUploadCommand
import {base-package}.application.video.cancelUpload.CancelUploadHandler
import java.util.UUID
import org.springframework.http.HttpStatus
import org.springframework.web.bind.annotation.DeleteMapping
import org.springframework.web.bind.annotation.PathVariable
import org.springframework.web.bind.annotation.ResponseStatus
import org.springframework.web.bind.annotation.RestController

@RestController
class CancelUploadRoute(private val handler: CancelUploadHandler) {

    @DeleteMapping("{api-routes-prefix}/videos/{id}/upload")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    fun handle(@PathVariable id: UUID) = handler.handle(CancelUploadCommand(id))
}
