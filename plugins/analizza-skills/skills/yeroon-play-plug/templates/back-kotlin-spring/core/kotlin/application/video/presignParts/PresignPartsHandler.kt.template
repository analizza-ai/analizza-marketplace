package {base-package}.application.video.presignParts

import {base-package}.domain.{video-entity}NotFoundException
import {base-package}.domain.{video-entity}RequestInvalidException
import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient
import org.springframework.stereotype.Component

@Component
class PresignPartsHandler(private val yeroon: YeroonClient, private val videos: {video-entity}Repository) {

    fun handle(command: PresignPartsCommand): PresignPartsResult {
        {video-entity}RequestInvalidException.requireFields("partNumbers" to command.partNumbers)
        val partNumbers = command.partNumbers.orEmpty()
        if (!videos.existsById(command.videoId)) throw {video-entity}NotFoundException()
        return PresignPartsResult(
            yeroon.partUrls(command.videoId, partNumbers).map { PresignPartsResult.PartUrl(it.partNumber, it.url.toString()) },
        )
    }
}
