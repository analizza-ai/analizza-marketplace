package {base-package}.application.video.completeUpload

import {base-package}.domain.{video-entity}NotFoundException
import {base-package}.domain.{video-entity}RequestInvalidException
import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonPart
import org.springframework.stereotype.Component

@Component
class CompleteUploadHandler(private val yeroon: YeroonClient, private val videos: {video-entity}Repository) {

    fun handle(command: CompleteUploadCommand): CompleteUploadResult {
        {video-entity}RequestInvalidException.requireFields("parts" to command.parts)
        val parts = command.parts.orEmpty()
        if (!videos.existsById(command.videoId)) throw {video-entity}NotFoundException()
        val completed = yeroon.complete(command.videoId, parts.map { YeroonPart(it.partNumber, it.etag) })
        return CompleteUploadResult(completed.videoId, completed.status)
    }
}
