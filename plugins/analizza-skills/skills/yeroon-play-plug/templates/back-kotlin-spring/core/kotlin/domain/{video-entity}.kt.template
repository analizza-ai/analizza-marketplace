package {base-package}.domain

import java.time.Instant
import java.util.UUID

/**
 * Vídeo hospedado no yeroon play. O projeto guarda só o id (o videoId da /v1) e
 * quando foi criado: arquivo, status, partes e URLs de mídia são da plataforma.
 */
class {video-entity} private constructor(val id: UUID, val createdAt: Instant) {

    companion object {
        fun register(yeroonVideoId: UUID, now: Instant): {video-entity} = {video-entity}(yeroonVideoId, now)

        fun restore(id: UUID, createdAt: Instant): {video-entity} = {video-entity}(id, createdAt)
    }
}
