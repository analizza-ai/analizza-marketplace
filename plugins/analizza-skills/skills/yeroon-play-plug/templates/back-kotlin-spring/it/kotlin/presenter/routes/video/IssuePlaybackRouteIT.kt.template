package {base-package}.presenter.routes.video

import {base-package}.domain.{video-entity}
import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*
import {base-package}.support.FakeYeroonClient
import {base-package}.support.YeroonIntegrationTest
import java.net.URI
import java.time.Instant
import java.util.UUID
import org.junit.jupiter.api.Assertions.assertEquals
import org.junit.jupiter.api.Assertions.assertFalse
import org.junit.jupiter.api.Assertions.assertTrue
import org.junit.jupiter.api.Test
import org.springframework.beans.factory.annotation.Autowired
import org.springframework.http.MediaType

class IssuePlaybackRouteIT : YeroonIntegrationTest() {

    @Autowired
    private lateinit var videos: {video-entity}Repository

    private fun registrado(): UUID = UUID.randomUUID().also { videos.save({video-entity}.register(it, Instant.now())) }

    @Test
    fun devolveSoEmbedUrlHlsUrlEExpiresAt() {
        val id = registrado()

        api.post().uri("{api-routes-prefix}/videos/{id}/playback", id).exchange()
            .expectStatus().isOk()
            .expectHeader().valueEquals("Cache-Control", "no-store")
            .expectBody()
            .jsonPath("$.embedUrl").isEqualTo("https://play.example/embed/tkn-$id")
            .jsonPath("$.hlsUrl").isEqualTo("https://play.example/api/play/tkn-$id/master.m3u8")
            .jsonPath("$.expiresAt").exists()
            .jsonPath("$.token").doesNotExist()
            .jsonPath("$.videoId").doesNotExist()
    }

    @Test
    fun cadaAberturaPedeUmTokenNovo() {
        val id = registrado()

        api.post().uri("{api-routes-prefix}/videos/{id}/playback", id).exchange().expectStatus().isOk()
        api.post().uri("{api-routes-prefix}/videos/{id}/playback", id).exchange().expectStatus().isOk()
        assertEquals(2, yeroon.calls())
    }

    @Test
    fun videoAindaNaoProntoRetorna409() {
        val id = registrado()
        yeroon.failNext(YeroonConflictException())

        api.post().uri("{api-routes-prefix}/videos/{id}/playback", id).exchange().expectStatus().isEqualTo(409)
    }

    @Test
    fun idForaDaTabelaRetorna404SemChamarAV1() {
        api.post().uri("{api-routes-prefix}/videos/{id}/playback", UUID.randomUUID()).exchange()
            .expectStatus().isNotFound()
        assertEquals(0, yeroon.calls())
    }
}
