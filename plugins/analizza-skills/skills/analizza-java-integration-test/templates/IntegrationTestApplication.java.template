package {base.package};

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

/**
 * Application unica para os testes de integracao.
 *
 * <p>Mescla o component scan dos {@code @SpringBootApplication} dos demais modulos.
 * Ajuste {@code scanBasePackages} para cobrir os pacotes de todos os modulos incluidos.
 */
@SpringBootApplication(
        scanBasePackages = {"{base.package}"}
)
public class IntegrationTestApplication {

    public static void main(String[] args) {
        SpringApplication.run(IntegrationTestApplication.class, args);
    }
}
