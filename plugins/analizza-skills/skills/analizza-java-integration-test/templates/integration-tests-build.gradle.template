// ============================================================================
// build.gradle (Groovy DSL) do modulo {base}-integration-tests.
// Modulo NAO implantavel: `jar` e `bootJar` desabilitados.
// ============================================================================

plugins {
    id 'application'
}

dependencies {
    // Gerar um testImplementation project(':<modulo>') para CADA modulo listado em
    // settings.gradle (exceto o proprio {base}-integration-tests). Exemplo:
    // testImplementation project(':{base}-core')
    // testImplementation project(':{base}-api')
    // testImplementation project(':{base}-async')
{project-dependencies}

    // Test slices
    testImplementation 'org.springframework.boot:spring-boot-starter-actuator-test'
    testImplementation 'org.springframework.boot:spring-boot-starter-data-jdbc-test'
    testImplementation 'org.springframework.boot:spring-boot-starter-data-jpa-test'
    testImplementation 'org.springframework.boot:spring-boot-starter-opentelemetry-test'
    testImplementation 'org.springframework.boot:spring-boot-starter-restclient-test'
    testImplementation 'org.springframework.boot:spring-boot-starter-webmvc-test'
    testImplementation 'org.springframework.boot:spring-boot-testcontainers'
    testImplementation 'org.springframework.boot:spring-boot-starter-flyway'

    // JUnit 5 + Mockito + AssertJ chegam via spring-boot-starter-test.
    // Para mockar beans do contexto use @MockitoBean/@MockitoSpyBean (nativos do Spring Boot).
    testImplementation 'org.springframework.boot:spring-boot-starter-test'
    testRuntimeOnly 'org.junit.platform:junit-platform-launcher'

    // Testcontainers
    testImplementation 'org.testcontainers:testcontainers-junit-jupiter'

    // WireMock / Awaitility
    testImplementation 'org.wiremock:wiremock-standalone:3.9.1'
    testImplementation 'org.awaitility:awaitility:4.3.0'

    // ArchUnit
    testImplementation 'com.tngtech.archunit:archunit-junit5:1.4.1'
}

jar {
    enabled = false
}

bootJar {
    enabled = false
}

tasks.withType(Test).configureEach {
    maxHeapSize = '2g'
    workingDir = projectDir
}
