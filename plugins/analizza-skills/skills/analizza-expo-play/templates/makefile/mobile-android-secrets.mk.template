
##@ Android Google Play

# Grava as cinco credenciais do Google Play no environment do GitHub de um
# ambiente (Dev ou Prod). Os valores vêm do shell de quem roda; nada fica em
# arquivo do repositório. Exemplo (arquivos FORA do repositório):
#   read -s "ANDROID_STORE_PASSWORD?Senha do keystore: " && export ANDROID_STORE_PASSWORD
#   export ANDROID_KEY_PASSWORD="$ANDROID_STORE_PASSWORD" ANDROID_KEY_ALIAS=<alias>
#   export ANDROID_KEYSTORE_BASE64="$(base64 -i <pasta-segura>/<keystore>.jks)"
#   export GOOGLE_PLAY_SERVICE_ACCOUNT="$(cat <pasta-segura>/<service-account>.json)"
#   make mobile-android-secrets ENV=<environment>
ANDROID_SECRETS = ANDROID_KEYSTORE_BASE64 ANDROID_STORE_PASSWORD ANDROID_KEY_ALIAS ANDROID_KEY_PASSWORD GOOGLE_PLAY_SERVICE_ACCOUNT
GH_REPO ?= {github-repo}

.PHONY: mobile-android-secrets
mobile-android-secrets: ## Grava as credenciais do Google Play no environment ENV=<environment> do GitHub (valores vêm do shell)
	@[ -n "$(ENV)" ] || { echo "ENV=<environment> obrigatório, ex.: make mobile-android-secrets ENV=meu-app-dev"; exit 1; }
	@faltando=""; for n in $(ANDROID_SECRETS); do eval "v=\$${$$n:-}"; [ -n "$$v" ] || faltando="$$faltando $$n"; done; \
		[ -z "$$faltando" ] || { echo "Exporte antes:$$faltando"; exit 1; }
	@command -v gh >/dev/null 2>&1 || { echo "gh não encontrado: instale o GitHub CLI e rode gh auth login"; exit 1; }
	@# Só cria o environment se ele não existir (404): o PUT também atualiza e
	@# zeraria a proteção (aprovação obrigatória) configurada nele. Qualquer outro
	@# erro (sem login, sem acesso) para aqui, sem PUT.
	@if saida=$$(gh api "repos/$(GH_REPO)/environments/$(ENV)" --silent 2>&1); then \
		echo "environment $(ENV) já existe (proteção mantida)"; \
	elif printf '%s' "$$saida" | grep -q 'HTTP 404'; then \
		gh api -X PUT "repos/$(GH_REPO)/environments/$(ENV)" --silent && echo "environment $(ENV) criado" || exit 1; \
	else \
		echo "Não deu para consultar o environment $(ENV) em $(GH_REPO): $$saida"; exit 1; \
	fi
	@for n in $(ANDROID_SECRETS); do eval "v=\$${$$n}"; printf '%s' "$$v" | gh secret set "$$n" --repo "$(GH_REPO)" --env "$(ENV)" >/dev/null || { echo "Falhou ao gravar $$n"; exit 1; }; echo "  $$n gravado"; done
