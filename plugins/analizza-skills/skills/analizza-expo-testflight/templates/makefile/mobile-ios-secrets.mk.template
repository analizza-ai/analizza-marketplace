
##@ iOS TestFlight

# Grava as cinco credenciais do TestFlight no environment do GitHub de um
# ambiente (Dev ou Prod). Os valores vêm do shell de quem roda; nada fica em
# arquivo do repositório. Exemplo (arquivos FORA do repositório):
#   export APPLE_API_KEY_ID=<Key ID> APPLE_API_ISSUER_ID=<Issuer ID>
#   export APPLE_API_KEY_P8="$(cat <pasta-segura>/AuthKey_<KEYID>.p8)"
#   export IOS_DISTRIBUTION_CERT_BASE64="$(base64 -i <pasta-segura>/distribution.p12)"
#   export IOS_CERTIFICATE_PASSWORD=<senha do .p12>
#   make mobile-ios-secrets ENV=<environment>
IOS_SECRETS = APPLE_API_KEY_ID APPLE_API_ISSUER_ID APPLE_API_KEY_P8 IOS_DISTRIBUTION_CERT_BASE64 IOS_CERTIFICATE_PASSWORD
GH_REPO ?= {github-repo}

.PHONY: mobile-ios-secrets
mobile-ios-secrets: ## Grava as credenciais do TestFlight no environment ENV=<environment> do GitHub (valores vêm do shell)
	@[ -n "$(ENV)" ] || { echo "ENV=<environment> obrigatório, ex.: make mobile-ios-secrets ENV=meu-app-dev"; exit 1; }
	@faltando=""; for n in $(IOS_SECRETS); do eval "v=\$${$$n:-}"; [ -n "$$v" ] || faltando="$$faltando $$n"; done; \
		[ -z "$$faltando" ] || { echo "Exporte antes:$$faltando"; exit 1; }
	@command -v gh >/dev/null 2>&1 || { echo "gh não encontrado: instale o GitHub CLI e rode gh auth login"; exit 1; }
	@# Só cria o environment se ele não existir (404): o PUT também atualiza e
	@# zeraria a proteção (aprovação obrigatória) configurada nele. Qualquer outro
	@# erro (sem login, sem acesso) para aqui, sem PUT.
	@if saida=$$(gh api "repos/$(GH_REPO)/environments/$(ENV)" --silent 2>&1); then \
		echo "environment $(ENV) já existe (proteção mantida)"; \
	elif printf '%s' "$$saida" | grep -q 'HTTP 404'; then \
		gh api -X PUT "repos/$(GH_REPO)/environments/$(ENV)" --silent && echo "environment $(ENV) criado" || exit 1; \
	else \
		echo "Não deu para consultar o environment $(ENV) em $(GH_REPO): $$saida"; exit 1; \
	fi
	@for n in $(IOS_SECRETS); do eval "v=\$${$$n}"; printf '%s' "$$v" | gh secret set "$$n" --repo "$(GH_REPO)" --env "$(ENV)" >/dev/null || { echo "Falhou ao gravar $$n"; exit 1; }; echo "  $$n gravado"; done
