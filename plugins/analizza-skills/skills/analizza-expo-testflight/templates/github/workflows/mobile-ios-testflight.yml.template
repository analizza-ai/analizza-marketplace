# se dev
name: Mobile iOS TestFlight Dev

# Builda o app Expo como o app de desenvolvimento e envia ao TestFlight
# (testers internos). Disparo manual, de qualquer branch menos a
# {default-branch}; tag nunca. A {default-branch} e as tags ficam para produção.
# fim se dev
# se prod
name: Mobile iOS TestFlight Prod

# Builda o app Expo como o app de produção e envia ao TestFlight. Disparo por
# tag v<versão>, igual ao "version" do app.json, num commit que já está na
# {default-branch}. Do TestFlight, a promoção para a App Store é manual.
# fim se prod
#
# As guardas rodam antes de qualquer passo que leia credencial.
# Identidade não secreta: {properties-file}, versionada para que toda mudança
# apareça num PR. Credenciais: environment {github-environment} do GitHub,
# gravadas por `make mobile-ios-secrets ENV={github-environment}`.
#
# Assinatura: archive sem assinatura e export assinado com a chave da App
# Store Connect API, que cria o perfil de distribuição na hora. Nenhum perfil
# de provisionamento vira secret.
#
# Runbook: docs/checkpoints/testflight-ios-{env}.md

on:
# se dev
  workflow_dispatch:
# fim se dev
# se prod
  push:
    tags:
      - "v*"
# fim se prod

run-name: "iOS {env} — ${{ github.ref_name }}"

concurrency:
  group: ios-testflight-{env}
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  build-and-upload:
    name: Build e upload para o TestFlight
    runs-on: macos-26
    environment: {github-environment}
    timeout-minutes: 60
    env:
      LANG: en_US.UTF-8
      LC_ALL: en_US.UTF-8
    steps:
      - uses: actions/checkout@v4
# se prod
        with:
          fetch-depth: 0
# fim se prod

# se dev
      - name: Guarda de branch
        env:
          REF: ${{ github.ref }}
        run: bash .github/scripts/ios-identity.sh guard-branch "$REF" "{default-branch}"
# fim se dev
# se prod
      - name: Guarda de tag
        env:
          REF: ${{ github.ref }}
        run: |
          versao=$(node -p "require('./{app-dir}/app.json').expo.version")
          bash .github/scripts/ios-identity.sh guard-tag "$REF" "$versao"

      - name: Guarda do commit na {default-branch}
        run: bash .github/scripts/ios-identity.sh on-default "{default-branch}"
# fim se prod

      - name: Identidade do app
        id: identity
        run: |
          bash .github/scripts/ios-identity.sh load {properties-file} >> "$GITHUB_OUTPUT"
          # As variáveis públicas do app (EXPO_PUBLIC_*) valem para o prebuild e o archive.
          bash .github/scripts/ios-identity.sh public-env {properties-file} >> "$GITHUB_ENV"

      - name: Credenciais presentes
        env:
          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
          APPLE_API_ISSUER_ID: ${{ secrets.APPLE_API_ISSUER_ID }}
          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
          IOS_DISTRIBUTION_CERT_BASE64: ${{ secrets.IOS_DISTRIBUTION_CERT_BASE64 }}
          IOS_CERTIFICATE_PASSWORD: ${{ secrets.IOS_CERTIFICATE_PASSWORD }}
        run: |
          faltando=()
          for nome in APPLE_API_KEY_ID APPLE_API_ISSUER_ID APPLE_API_KEY_P8 IOS_DISTRIBUTION_CERT_BASE64 IOS_CERTIFICATE_PASSWORD; do
            [[ -n "${!nome:-}" ]] || faltando+=("$nome")
          done
          if (( ${#faltando[@]} > 0 )); then
            echo "::error::O environment {github-environment} está sem: ${faltando[*]}. Veja make mobile-ios-secrets ENV={github-environment}."
            exit 1
          fi

      - name: Xcode
        uses: maxim-lobanov/setup-xcode@v1
        with:
          xcode-version: latest-stable

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: {app-dir}/package-lock.json

      - name: Dependências
        working-directory: {app-dir}
        run: npm ci

      - name: Versão
        id: version
        env:
          BUILD_NUMBER: ${{ github.run_number }}
        run: |
          # Nome da versão vem do app.json; o número do build vem do run, único e
          # crescente, porque o App Store Connect recusa número repetido.
          versao=$(node -p "require('./{app-dir}/app.json').expo.version")
          echo "version=${versao}" >> "$GITHUB_OUTPUT"
          echo "build_number=${BUILD_NUMBER}" >> "$GITHUB_OUTPUT"
          xcodebuild -version
          echo "Versão ${versao} (${BUILD_NUMBER})"

      - name: Prebuild
        working-directory: {app-dir}
        env:
          APP_DISPLAY_NAME: ${{ steps.identity.outputs.app_name }}
          IOS_BUNDLE_ID: ${{ steps.identity.outputs.ios_bundle_id }}
          APPLE_TEAM_ID: ${{ steps.identity.outputs.apple_team_id }}
          IOS_BUILD_NUMBER: ${{ steps.version.outputs.build_number }}
        run: npx expo prebuild --clean --platform ios

      - name: Certificado de distribuição
        env:
          IOS_DISTRIBUTION_CERT_BASE64: ${{ secrets.IOS_DISTRIBUTION_CERT_BASE64 }}
          IOS_CERTIFICATE_PASSWORD: ${{ secrets.IOS_CERTIFICATE_PASSWORD }}
        run: |
          KEYCHAIN_PATH="${RUNNER_TEMP}/build.keychain-db"
          KEYCHAIN_PASSWORD="$(uuidgen)"
          echo "KEYCHAIN_PATH=${KEYCHAIN_PATH}" >> "$GITHUB_ENV"
          printf '%s' "$IOS_DISTRIBUTION_CERT_BASE64" | base64 --decode > "${RUNNER_TEMP}/certificate.p12"
          security create-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
          security set-keychain-settings -lut 21600 "$KEYCHAIN_PATH"
          security unlock-keychain -p "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH"
          security import "${RUNNER_TEMP}/certificate.p12" -k "$KEYCHAIN_PATH" -P "$IOS_CERTIFICATE_PASSWORD" \
            -T /usr/bin/codesign -T /usr/bin/security
          # Sem isso o codesign para num prompt do keychain que ninguém responde no runner.
          security set-key-partition-list -S apple-tool:,apple: -s -k "$KEYCHAIN_PASSWORD" "$KEYCHAIN_PATH" > /dev/null
          # A lista atual precisa ser separada em palavras: um argumento por keychain.
          # shellcheck disable=SC2046
          security list-keychains -d user -s "$KEYCHAIN_PATH" $(security list-keychains -d user | tr -d '"')
          rm -f "${RUNNER_TEMP}/certificate.p12"

      - name: Chave da App Store Connect API
        env:
          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
          APPLE_API_KEY_P8: ${{ secrets.APPLE_API_KEY_P8 }}
        run: |
          mkdir -p ~/.appstoreconnect/private_keys
          KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_${APPLE_API_KEY_ID}.p8
          printf '%s' "$APPLE_API_KEY_P8" > "$KEY_PATH"
          chmod 600 "$KEY_PATH"
          # A assinatura automática precisa da chave, do id e do issuer juntos.
          echo "APPLE_API_KEY_PATH=${KEY_PATH}" >> "$GITHUB_ENV"

      - name: ExportOptions.plist
        env:
          TEAM_ID: ${{ steps.identity.outputs.apple_team_id }}
        run: |
          cat > "${RUNNER_TEMP}/ExportOptions.plist" <<EOF
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key>
            <string>app-store-connect</string>
            <key>teamID</key>
            <string>${TEAM_ID}</string>
            <key>signingStyle</key>
            <string>automatic</string>
            <key>uploadSymbols</key>
            <true/>
            <key>destination</key>
            <string>export</string>
          </dict>
          </plist>
          EOF

      # O archive sai sem assinatura de propósito: com assinatura automática, o
      # archive pede um perfil de desenvolvimento, feito de aparelhos
      # registrados, e o runner não é um aparelho. A assinatura acontece no
      # export, onde o método de distribuição é declarado.
      - name: Archive
        working-directory: {app-dir}/ios
        env:
          APP_DISPLAY_NAME: ${{ steps.identity.outputs.app_name }}
          IOS_BUNDLE_ID: ${{ steps.identity.outputs.ios_bundle_id }}
        run: |
          xcodebuild \
            -workspace {xcode-workspace}.xcworkspace \
            -scheme {xcode-scheme} \
            -configuration Release \
            -destination 'generic/platform=iOS' \
            -archivePath "${RUNNER_TEMP}/app.xcarchive" \
            CODE_SIGNING_ALLOWED=NO \
            archive

      - name: Export assinado
        env:
          APPLE_API_KEY_ID: ${{ secrets.APPLE_API_KEY_ID }}
          APPLE_API_ISSUER_ID: ${{ secrets.APPLE_API_ISSUER_ID }}
        run: |
          xcodebuild -exportArchive \
            -archivePath "${RUNNER_TEMP}/app.xcarchive" \
            -exportOptionsPlist "${RUNNER_TEMP}/ExportOptions.plist" \
            -exportPath "${RUNNER_TEMP}/ipa" \
            -allowProvisioningUpdates \
            -authenticationKeyPath "$APPLE_API_KEY_PATH" \
            -authenticationKeyID "$APPLE_API_KEY_ID" \
            -authenticationKeyIssuerID "$APPLE_API_ISSUER_ID"

      - name: Localiza o .ipa
        id: artifact
        run: |
          IPA_PATH="$(find "${RUNNER_TEMP}/ipa" -maxdepth 1 -name '*.ipa' | head -n 1)"
          if [[ -z "$IPA_PATH" ]]; then
            echo "::error::Nenhum .ipa gerado em ${RUNNER_TEMP}/ipa"
            exit 1
          fi
          echo "path=${IPA_PATH}" >> "$GITHUB_OUTPUT"

      - name: Upload para o TestFlight
        uses: Apple-Actions/upload-testflight-build@v1
        with:
          app-path: ${{ steps.artifact.outputs.path }}
          issuer-id: ${{ secrets.APPLE_API_ISSUER_ID }}
          api-key-id: ${{ secrets.APPLE_API_KEY_ID }}
          api-private-key: ${{ secrets.APPLE_API_KEY_P8 }}

      - name: Resumo
        env:
          APP_NAME: ${{ steps.identity.outputs.app_name }}
          BUNDLE: ${{ steps.identity.outputs.ios_bundle_id }}
          VERSAO: ${{ steps.version.outputs.version }}
          BUILD: ${{ steps.version.outputs.build_number }}
          REF_NAME: ${{ github.ref_name }}
        run: |
          {
            echo "### ${APP_NAME} enviado ao TestFlight"
            echo "- Bundle: \`${BUNDLE}\`"
            echo "- Versão: ${VERSAO} (${BUILD})"
            echo "- Ref: \`${REF_NAME}\`"
            env | grep '^EXPO_PUBLIC_' | sort | sed 's/^/- /'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Remove material de credencial
        if: always()
        run: |
          rm -rf ~/.appstoreconnect/private_keys
          rm -f "${RUNNER_TEMP}/certificate.p12"
          if [[ -n "${KEYCHAIN_PATH:-}" && -f "${KEYCHAIN_PATH}" ]]; then
            security delete-keychain "${KEYCHAIN_PATH}"
          fi
