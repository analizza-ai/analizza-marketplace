package {package}.domain;

import java.util.Arrays;
import java.util.List;

public class RuleChecker {
    public void checkAllRules(BusinessRule... rules) {
        List<BusinessRule> brokenRules = Arrays.stream(rules)
            .filter(BusinessRule::isBroken)
            .toList();

        if (!brokenRules.isEmpty()) {
            throw new BusinessRulesBrokenException(brokenRules);
        }
    }
}
