package {package}.domain;

import java.util.List;
import java.util.stream.Collectors;

public class BusinessRulesBrokenException extends RuntimeException {
    private final List<BusinessRule> brokenRules;

    public BusinessRulesBrokenException(List<BusinessRule> brokenRules) {
        this.brokenRules = brokenRules;
    }

    public List<BusinessRule> getBrokenRules() {
        return brokenRules;
    }

    @Override
    public String getMessage() {
        return brokenRules.stream()
            .map(rule -> rule.getId() + ": " + rule.getMessage())
            .collect(Collectors.joining(", "));
    }
}
