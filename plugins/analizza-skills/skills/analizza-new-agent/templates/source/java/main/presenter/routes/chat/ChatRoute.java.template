package {base-package}.presenter.routes.chat;

import {base-package}.application.chat.ChatCommand;
import {base-package}.application.chat.ChatHandler;
import {base-package}.application.chat.ChatStreamHandler;
import org.jspecify.annotations.Nullable;
import org.springframework.http.MediaType;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestHeader;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;
import reactor.core.publisher.Flux;

/**
 * Entrada do agente. Sem regra de negocio: resolve a conversa, monta o Command
 * e traduz o resultado. A validacao do corpo e do handler, para valer tambem
 * para quem chamar o caso de uso por outro caminho.
 */
@RestController
@RequestMapping("/api/v1/agent")
public class ChatRoute {

    private final ChatHandler chatHandler;
    private final ChatStreamHandler chatStreamHandler;

    public ChatRoute(ChatHandler chatHandler, ChatStreamHandler chatStreamHandler) {
        this.chatHandler = chatHandler;
        this.chatStreamHandler = chatStreamHandler;
    }

    @PostMapping(
            value = "/http",
            consumes = MediaType.APPLICATION_JSON_VALUE,
            produces = MediaType.APPLICATION_JSON_VALUE)
    public ChatResponse chat(
            @RequestBody ChatRequest request,
            @RequestHeader(name = ConversationIds.HEADER, required = false) @Nullable String header) {
        ChatCommand command = new ChatCommand(ConversationIds.resolve(header, request.from()), request.body());
        return new ChatResponse(chatHandler.handle(command).response());
    }

    @PostMapping(
            value = "/stream",
            consumes = MediaType.APPLICATION_JSON_VALUE,
            produces = MediaType.TEXT_EVENT_STREAM_VALUE)
    public Flux<String> stream(
            @RequestBody ChatRequest request,
            @RequestHeader(name = ConversationIds.HEADER, required = false) @Nullable String header) {
        return chatStreamHandler.handle(
                new ChatCommand(ConversationIds.resolve(header, request.from()), request.body()));
    }
}
