package {base-package}.presenter.routes.chat;

import {base-package}.application.chat.Whitespace;
import java.util.UUID;
import org.jspecify.annotations.Nullable;

/**
 * Resolve o identificador da conversa. Precedencia: header, depois o campo
 * `from` do corpo, depois um UUID novo. O limite de tamanho existe porque o
 * valor vira chave de memoria e atributo de span.
 */
public final class ConversationIds {

    public static final String HEADER = "X-Conversation-Id";
    private static final int MAX_LENGTH = 128;

    private ConversationIds() {
    }

    public static String resolve(@Nullable String header, @Nullable String from) {
        String candidate;
        if (header != null && !Whitespace.isBlank(header)) {
            candidate = Whitespace.trim(header);
        } else if (from != null && !Whitespace.isBlank(from)) {
            candidate = Whitespace.trim(from);
        } else {
            candidate = null;
        }
        if (candidate == null) {
            return UUID.randomUUID().toString();
        }
        return candidate.substring(0, Math.min(candidate.length(), MAX_LENGTH));
    }
}
