################################################################################
# LangWatch — Configuração de Ambiente Local (self-hosted via Docker Compose)
################################################################################
#
# Para usar:
#   1. Copie este arquivo para `langwatch.env` (git-ignored)
#   2. Gere um valor único para cada segredo abaixo, por exemplo:
#        openssl rand -hex 32
#   3. Suba o stack:
#        docker compose -f docker-compose.langwatch.yml --env-file langwatch.env up -d
#
# IMPORTANTE: Nunca commitar este arquivo com valores reais.
#
# Este LangWatch e so local: serve para ver os traces do agente durante o
# desenvolvimento. Nao e o ambiente de observabilidade de producao.
#
################################################################################

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Segredos obrigatórios (um valor único por segredo)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LANGWATCH_API_TOKEN_JWT_SECRET=change-it
LANGWATCH_CREDENTIALS_SECRET=change-it
LANGWATCH_NEXTAUTH_SECRET=change-it
LANGWATCH_CRON_API_KEY=change-it

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Credenciais de infraestrutura (opcional — defaults já funcionam localmente)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

LANGWATCH_POSTGRES_PASSWORD=langwatch
LANGWATCH_CLICKHOUSE_PASSWORD=langwatch
