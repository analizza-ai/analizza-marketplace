// ============================================================================
// Trechos para o build.gradle.kts da RAIZ.
// Adaptar a estrutura existente do projeto (mesclar em subprojects, etc.).
// Gerar uma linha jacocoAggregation(...) para CADA modulo listado em
// settings.gradle.kts, INCLUINDO o novo {base}-integration-tests.
// ============================================================================

plugins {
    `jacoco-report-aggregation`
}

dependencies {
    // Um jacocoAggregation(project(":<modulo>")) por modulo de settings.gradle.kts. Exemplo:
    // jacocoAggregation(project(":{base}-core"))
    // jacocoAggregation(project(":{base}-api"))
    // jacocoAggregation(project(":{base}-async"))
{jacoco-aggregation}
    jacocoAggregation(project(":{base}-integration-tests"))
}

subprojects {

    // ...outras configuracoes existentes...

    // `test` roda apenas os testes unitarios (sem a tag `integration`) -> rapido, sem Testcontainers.
    tasks.named<Test>("test") {
        useJUnitPlatform {
            excludeTags("integration")
        }
        finalizedBy(tasks.jacocoTestReport)
    }

    // `integrationTest` roda apenas os testes marcados com @Tag("integration") -> sobe Testcontainers.
    val integrationTest = tasks.register<Test>("integrationTest") {
        description = "Runs integration tests tagged with 'integration'."
        group = "verification"
        testClassesDirs = sourceSets.test.get().output.classesDirs
        classpath = sourceSets.test.get().runtimeClasspath
        useJUnitPlatform {
            includeTags("integration")
        }
        // Modulos sem testes de integracao nao devem falhar.
        filter {
            isFailOnNoMatchingTests = false
        }
        shouldRunAfter(tasks.named("test"))
    }

    tasks.withType<JacocoReport> {
        mustRunAfter(tasks.named("test"), integrationTest)
        // Agrega a cobertura de `test` (unit) e `integrationTest` quando ambos executam.
        executionData(
            fileTree(layout.buildDirectory).include("jacoco/test.exec", "jacoco/integrationTest.exec")
        )
        reports {
            xml.required.set(true)
            xml.outputLocation.set(file("../build/reports/jacoco/${project.name}.xml"))
            csv.required.set(false)
            html.required.set(true)
        }
        classDirectories.setFrom(
            sourceSets.main.get().output.asFileTree.matching {
                exclude(excludeFromCoverageJacoco)
            }
        )
    }
}

tasks.named<JacocoReport>("testCodeCoverageReport") {
    executionData.from(
        subprojects.map { sub ->
            sub.fileTree(sub.layout.buildDirectory).include("jacoco/integrationTest.exec")
        }
    )

    reports {
        xml.required.set(true)
        xml.outputLocation.set(file("build/reports/jacoco/jacoco-aggregated.xml"))
        csv.required.set(false)
        html.required.set(true)
    }

    val rawClassDirectories = files(classDirectories.files)
    classDirectories.setFrom(
        rawClassDirectories.asFileTree.matching {
            exclude(excludeFromCoverageJacoco)
        }
    )
}

tasks.register<JacocoCoverageVerification>("jacocoAggregatedCoverageVerification") {
    dependsOn("testCodeCoverageReport")
    val aggregatedReport = tasks.named<JacocoReport>("testCodeCoverageReport")
    executionData.setFrom(aggregatedReport.map { it.executionData })
    sourceDirectories.setFrom(aggregatedReport.map { it.sourceDirectories })
    classDirectories.setFrom(aggregatedReport.map { it.classDirectories })

    violationRules {
        rule {
            limit {
                counter = "LINE"
                minimum = BigDecimal("0.80")
            }
        }
        rule {
            limit {
                counter = "BRANCH"
                minimum = BigDecimal("0.80")
            }
        }
    }
}
