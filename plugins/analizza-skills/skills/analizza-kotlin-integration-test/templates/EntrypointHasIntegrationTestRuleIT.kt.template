package {base.package}.architecture

import com.tngtech.archunit.base.DescribedPredicate
import com.tngtech.archunit.core.domain.JavaClass
import com.tngtech.archunit.core.domain.JavaClasses
import com.tngtech.archunit.core.importer.ClassFileImporter
import com.tngtech.archunit.lang.ArchCondition
import com.tngtech.archunit.lang.ConditionEvents
import com.tngtech.archunit.lang.SimpleConditionEvent
import com.tngtech.archunit.lang.syntax.ArchRuleDefinition.classes
import com.tngtech.archunit.library.freeze.FreezingArchRule
import org.junit.jupiter.api.Tag
import org.junit.jupiter.api.Test
import org.springframework.kafka.annotation.KafkaListener
import org.springframework.scheduling.annotation.Scheduled
import org.springframework.web.bind.annotation.RestController
import org.springframework.web.bind.annotation.RestControllerAdvice
import {base.package}.BaseIntegrationTest

@Tag("integration")
class EntrypointHasIntegrationTestRuleIT {

    private val importedClasses: JavaClasses = ClassFileImporter()
        .importPackages("{root.package.segment}")

    private val isEntrypoint: DescribedPredicate<JavaClass> =
        DescribedPredicate.describe("are entrypoints (@RestController, @KafkaListener or @Scheduled)") { javaClass ->
            javaClass.isAnnotatedWith(RestController::class.java) ||
                javaClass.methods.any { it.isAnnotatedWith(KafkaListener::class.java) } ||
                javaClass.methods.any { it.isAnnotatedWith(Scheduled::class.java) }
        }

    private fun haveCorrespondingIntegrationTest(allClasses: JavaClasses): ArchCondition<JavaClass> =
        object : ArchCondition<JavaClass>("have a corresponding integration test (<Name>IT extending BaseIntegrationTest)") {
            override fun check(entrypoint: JavaClass, events: ConditionEvents) {
                val expectedTestName = "${entrypoint.simpleName}IT"
                val testClassFound = allClasses.any { testClass ->
                    testClass.simpleName == expectedTestName &&
                        testClass.isAssignableTo(BaseIntegrationTest::class.java)
                }

                if (!testClassFound) {
                    events.add(
                        SimpleConditionEvent.violated(
                            entrypoint,
                            "Entrypoint ${entrypoint.name} does not have a corresponding " +
                                "integration test '$expectedTestName' extending BaseIntegrationTest",
                        ),
                    )
                } else {
                    events.add(
                        SimpleConditionEvent.satisfied(
                            entrypoint,
                            "Entrypoint ${entrypoint.name} has corresponding integration test '$expectedTestName'",
                        ),
                    )
                }
            }
        }

    @Test
    fun entrypointMustHaveIntegrationTest() {
        val rule = FreezingArchRule.freeze(
            classes()
                .that(isEntrypoint)
                .and().areNotAnnotatedWith(RestControllerAdvice::class.java)
                .should(haveCorrespondingIntegrationTest(importedClasses))
                .because("config.yaml: entrypoints exigem IT (BaseIntegrationTest)"),
        )
        rule.check(importedClasses)
    }
}
