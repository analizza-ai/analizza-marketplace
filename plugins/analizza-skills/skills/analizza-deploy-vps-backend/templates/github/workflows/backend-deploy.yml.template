name: Backend Deploy {Env}

# Builda as aplicacoes Spring Boot, publica as imagens no Docker Hub e sobe o
# ambiente {env} na VPS com docker compose. Deploy so manual (Run workflow), de
# qualquer branch: push nenhum publica. Na {default-branch} da para marcar
# "gerar_tag": depois do deploy, o job "tag" cria v<versao>
# (.github/scripts/release-tag.sh), a mesma tag dos outros deploys do produto.
#
# O .env.{env} nasce aqui, dos secrets e variaveis do environment
# {github-environment}; nada dele e versionado. As tags das imagens vao para o
# images.env, que so entra na interpolacao do compose: um deploy que nao muda a
# configuracao de um container nao o recria (ver deploy/docker-compose.{env}.yml).
#
# As actions ficam fixadas por commit (SHA), nao por tag: as credenciais da VPS
# e do Docker Hub passam por elas. Para atualizar, troque o SHA de proposito.
#
# Runbook: docs/checkpoints/deploy-backend-{env}.md

on:
  workflow_dispatch:
    inputs:
      gerar_tag:
        description: "Gerar a tag v<versao> depois do deploy (so na {default-branch})"
        type: boolean
        default: false

run-name: "Backend {env} — ${{ github.ref_name }}"

concurrency:
  group: backend-deploy-{env}
  cancel-in-progress: false

permissions:
  contents: read

env:
  REMOTE_DIR: {remote-dir}
  HEALTH_URL: {health-url}

jobs:
  deploy:
    name: Deploy backend ({env})
    runs-on: ubuntu-latest
    environment: {github-environment}
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      # Antes de qualquer secret: gerar_tag so na {default-branch}, e versao unica
      # do produto (todas as fontes de .github/versao.fontes iguais).
      - name: Guarda de tag e versao
        env:
          REF: ${{ github.ref }}
          GERAR_TAG: ${{ inputs.gerar_tag }}
        run: |
          bash .github/scripts/release-tag.sh check "$REF" "$GERAR_TAG" {default-branch}
          bash .github/scripts/version.sh check

      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
        with:
          distribution: temurin
          java-version: "{java-version}"
          cache: gradle

      - name: Build e testes unitarios
        run: ./gradlew build bootJar

      - uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3

      - uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
# por app

      - name: Imagem {app-module}
        uses: docker/build-push-action@10e90e3645eae34f1e60eeb005ba3a3d33f178e8 # v6
        with:
          context: {app-module}
          push: true
          tags: |
            ${{ secrets.DOCKERHUB_USERNAME }}/{app-module}:{env}
            ${{ secrets.DOCKERHUB_USERNAME }}/{app-module}:${{ github.sha }}
          cache-from: type=gha,scope={app-module}
          cache-to: type=gha,mode=max,scope={app-module}
# fim por app

      - name: Escreve o .env.{env}
        env:
          DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}
# se postgres
          POSTGRES_PASSWORD: ${{ secrets.POSTGRES_PASSWORD }}
# fim se postgres
# por variavel
          {var}: ${{ {fonte}.{var} }}
# fim por variavel
        run: |
          obrigatorias=(DOCKERHUB_USERNAME {required-vars})
          for nome in "${obrigatorias[@]}"; do
            [ -n "${!nome:-}" ] || { echo "::error::secret ou variavel ausente no environment {github-environment}: $nome"; exit 1; }
          done
          umask 077
          {
            echo "DOCKERHUB_USERNAME=$DOCKERHUB_USERNAME"
# se postgres
            echo "POSTGRES_DB={db-name}"
            echo "POSTGRES_USER={db-user}"
            echo "POSTGRES_PASSWORD=$POSTGRES_PASSWORD"
            echo "SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/{db-name}"
            echo "SPRING_DATASOURCE_USERNAME={db-user}"
            echo "SPRING_DATASOURCE_PASSWORD=$POSTGRES_PASSWORD"
# fim se postgres
            # Opcionais vazias ficam de fora: o application.properties decide o padrao.
            for nome in {all-vars}; do
              if [ -n "${!nome:-}" ]; then echo "$nome=${!nome}"; fi
            done
            echo "JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70"
          } > deploy/.env.{env}
          {
# por app
            echo "{app-tag-var}=${{ github.sha }}"
# fim por app
          } > deploy/images.env
          # O scp-action roda num container com outro usuario: precisa ler o
          # arquivo. O runner e descartavel; na VPS ele fica com chmod 600.
          chmod 644 deploy/.env.{env} deploy/images.env

      - name: Copia compose e env para a VPS
        uses: appleboy/scp-action@917f8b81dfc1ccd331fef9e2d61bdc6c8be94634 # v0.1.7
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
# se ssh-chave
          key: ${{ secrets.VPS_SSH_KEY }}
# fim se ssh-chave
# se ssh-senha
          password: ${{ secrets.VPS_SSH_PASSWORD }}
# fim se ssh-senha
          source: deploy/docker-compose.{env}.yml,deploy/.env.{env},deploy/images.env
          target: ${{ env.REMOTE_DIR }}
          strip_components: 1

      - name: Sobe na VPS
        uses: appleboy/ssh-action@7eaf76671a0d7eec5d98ee897acda4f968735a17 # v1.2.0
        with:
          command_timeout: 20m
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
# se ssh-chave
          key: ${{ secrets.VPS_SSH_KEY }}
# fim se ssh-chave
# se ssh-senha
          password: ${{ secrets.VPS_SSH_PASSWORD }}
# fim se ssh-senha
          envs: REMOTE_DIR
          script: |
            set -e
            cd "$REMOTE_DIR"
            chmod 600 .env.{env}
            dc="docker compose --env-file .env.{env} --env-file images.env -f docker-compose.{env}.yml"
            $dc pull
            $dc up -d
            $dc ps

      - name: Health check
        run: |
          deadline=$((SECONDS + 300))
          while [ "$SECONDS" -lt "$deadline" ]; do
            if curl --fail --silent --show-error --connect-timeout 2 --max-time 5 "$HEALTH_URL" > /dev/null 2>&1; then
              echo "Backend is healthy"
              exit 0
            fi
            echo "Health check falhou; tentando de novo..."
            sleep 5
          done
          echo "::error::Health check falhou: $HEALTH_URL"
          exit 1

  # Job separado para que so ele tenha permissao de escrita: cria a tag
  # v<versao> depois do deploy dar certo, se pedida (so a {default-branch} chega
  # aqui: a guarda recusa gerar_tag em outra branch).
  tag:
    name: Tag v<versao>
    needs: deploy
    if: ${{ inputs.gerar_tag }}
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      - name: Cria a tag
        run: |
          versao=$(bash .github/scripts/version.sh get)
          bash .github/scripts/release-tag.sh create "$versao"
          echo "- Tag: \`v$versao\` (backend)" >> "$GITHUB_STEP_SUMMARY"
