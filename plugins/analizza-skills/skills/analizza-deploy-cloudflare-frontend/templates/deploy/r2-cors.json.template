{
  "rules": [
    {
      "allowed": {
        "origins": [
// por origem
          "{origin}",
// fim por origem
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "content-type",
          "range"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
