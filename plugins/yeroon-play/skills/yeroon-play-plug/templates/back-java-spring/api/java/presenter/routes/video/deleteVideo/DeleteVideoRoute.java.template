package {base-package}.presenter.routes.video.deleteVideo;

import {base-package}.application.video.deleteVideo.*;
import java.util.UUID;
import org.springframework.http.HttpStatus;
import org.springframework.web.bind.annotation.*;

@RestController
public class DeleteVideoRoute {
    private final DeleteVideoHandler handler;

    public DeleteVideoRoute(DeleteVideoHandler handler) {
        this.handler = handler;
    }

    @DeleteMapping("{api-routes-prefix}/videos/{id}")
    @ResponseStatus(HttpStatus.NO_CONTENT)
    public void handle(@PathVariable UUID id) {
        handler.handle(new DeleteVideoCommand(id));
    }
}
