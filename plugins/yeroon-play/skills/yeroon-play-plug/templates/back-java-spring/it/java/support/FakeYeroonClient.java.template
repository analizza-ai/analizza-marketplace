package {base-package}.support;

import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*;
import java.net.URI;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.UUID;
import java.util.concurrent.ConcurrentHashMap;
import java.util.concurrent.atomic.AtomicInteger;

/** Dublê em memória da /v1 do yeroon play: nenhuma chamada de rede sai da suíte. */
public class FakeYeroonClient implements YeroonClient {

    public static final String ETAG = "\"etag-1\"";

    public final Map<UUID, YeroonVideo> videos = new ConcurrentHashMap<>();
    public final Set<UUID> deleted = ConcurrentHashMap.newKeySet();
    private final AtomicInteger calls = new AtomicInteger();
    private volatile RuntimeException nextFailure;

    public int calls() {
        return calls.get();
    }

    /** A próxima chamada lança esta exceção, como a /v1 responderia. */
    public void failNext(RuntimeException failure) {
        this.nextFailure = failure;
    }

    public void reset() {
        videos.clear();
        deleted.clear();
        calls.set(0);
        nextFailure = null;
    }

    private void enter() {
        calls.incrementAndGet();
        RuntimeException failure = nextFailure;
        if (failure != null) {
            nextFailure = null;
            throw failure;
        }
    }

    @Override
    public YeroonUpload initUpload(String fileName, String contentType, long sizeBytes) {
        enter();
        UUID id = UUID.randomUUID();
        videos.put(id, new YeroonVideo(id, fileName, "PENDENTE", null, List.of(), null));
        return new YeroonUpload(id, 8_388_608L, (int) Math.max(1, (sizeBytes + 8_388_607L) / 8_388_608L));
    }

    @Override
    public List<YeroonPartUrl> partUrls(UUID videoId, List<Integer> partNumbers) {
        enter();
        return partNumbers.stream()
                .map(n -> new YeroonPartUrl(n, URI.create("https://storage.example/" + videoId + "/" + n)))
                .toList();
    }

    @Override
    public List<YeroonUploadedPart> uploadedParts(UUID videoId) {
        enter();
        return List.of(new YeroonUploadedPart(1, ETAG, 1024));
    }

    @Override
    public YeroonCompleted complete(UUID videoId, List<YeroonPart> parts) {
        enter();
        return new YeroonCompleted(videoId, "ENVIADO");
    }

    @Override
    public void cancel(UUID videoId) {
        enter();
        videos.remove(videoId);
    }

    @Override
    public YeroonVideo get(UUID videoId) {
        enter();
        YeroonVideo video = videos.get(videoId);
        if (video == null) {
            throw new YeroonNotFoundException();
        }
        return video;
    }

    @Override
    public List<YeroonVideoSummary> list() {
        enter();
        return videos.values().stream()
                .map(v -> new YeroonVideoSummary(
                        v.videoId(), v.fileName(), v.status(), Instant.now(), v.thumbnailUrl(), 1024L))
                .toList();
    }

    @Override
    public YeroonPlayback playbackToken(UUID videoId) {
        enter();
        return new YeroonPlayback(
                URI.create("https://play.example/embed/tkn-" + videoId),
                URI.create("https://play.example/api/play/tkn-" + videoId + "/master.m3u8"),
                Instant.now().plusSeconds(6 * 3600));
    }

    @Override
    public void delete(UUID videoId) {
        enter();
        videos.remove(videoId);
        deleted.add(videoId);
    }
}
