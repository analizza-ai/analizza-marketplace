package {base-package}.presenter.routes.video;

import static org.junit.jupiter.api.Assertions.*;

import {base-package}.domain.{video-entity};
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*;
import {base-package}.support.FakeYeroonClient;
import {base-package}.support.YeroonIntegrationTest;
import java.net.URI;
import java.time.Instant;
import java.util.List;
import java.util.Map;
import java.util.UUID;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.MediaType;

class DeleteVideoRouteIT extends YeroonIntegrationTest {

    @Autowired
    private {video-entity}Repository videos;

    @Test
    void excluiNaV1EApagaALinha() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));

        api.delete().uri("{api-routes-prefix}/videos/{id}", id).exchange().expectStatus().isNoContent();
        assertTrue(yeroon.deleted.contains(id));
        assertFalse(videos.existsById(id));
    }

    @Test
    void idForaDaTabelaRetorna404SemChamarAV1() {
        UUID id = UUID.randomUUID();

        api.delete().uri("{api-routes-prefix}/videos/{id}", id).exchange().expectStatus().isNotFound();
        assertEquals(0, yeroon.calls());
    }

    @Test
    void videoNaoExcluivelRepassa422EMantemALinha() {
        UUID id = UUID.randomUUID();
        videos.save({video-entity}.register(id, Instant.now()));
        yeroon.failNext(new YeroonRejectedException(List.of(new YeroonError("video.deletable", "em processamento"))));

        api.delete().uri("{api-routes-prefix}/videos/{id}", id).exchange()
                .expectStatus().isEqualTo(422)
                .expectBody().jsonPath("$.errors[0].code").isEqualTo("video.deletable");
        assertTrue(videos.existsById(id));
    }
}
