package {base-package}.application.video.presignParts;

import {base-package}.domain.{video-entity}RequestInvalidException;
import {base-package}.domain.{video-entity}NotFoundException;
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient;
import org.springframework.stereotype.Component;

@Component
public class PresignPartsHandler {
    private final YeroonClient yeroon;
    private final {video-entity}Repository videos;

    public PresignPartsHandler(YeroonClient yeroon, {video-entity}Repository videos) {
        this.yeroon = yeroon;
        this.videos = videos;
    }

    public PresignPartsResult handle(PresignPartsCommand command) {
        {video-entity}RequestInvalidException.requireFields("partNumbers", command.partNumbers());
        if (!videos.existsById(command.videoId())) throw new {video-entity}NotFoundException();
        return new PresignPartsResult(yeroon.partUrls(command.videoId(), command.partNumbers()).stream()
                .map(p -> new PresignPartsResult.PartUrl(p.partNumber(), p.url().toString()))
                .toList());
    }
}
