package {base-package}.application.video.issuePlayback;

import {base-package}.domain.{video-entity}NotFoundException;
import {base-package}.domain.repositories.{video-entity}Repository;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient;
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonPlayback;
import org.springframework.stereotype.Component;

@Component
public class IssuePlaybackHandler {
    private final YeroonClient yeroon;
    private final {video-entity}Repository videos;

    public IssuePlaybackHandler(YeroonClient yeroon, {video-entity}Repository videos) {
        this.yeroon = yeroon;
        this.videos = videos;
    }

    /** Um token novo a cada abertura do vídeo; nada é guardado. */
    public IssuePlaybackResult handle(IssuePlaybackCommand command) {
        if (!videos.existsById(command.videoId())) throw new {video-entity}NotFoundException();
        YeroonPlayback playback = yeroon.playbackToken(command.videoId());
        return new IssuePlaybackResult(
                playback.embedUrl().toString(),
                playback.hlsUrl() == null ? null : playback.hlsUrl().toString(),
                playback.expiresAt());
    }
}
