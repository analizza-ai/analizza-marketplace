package {base-package}.infrastructure.configuration;

import java.net.URI;
import java.time.Duration;
import org.springframework.boot.context.properties.ConfigurationProperties;

/**
 * yeroon.api-url, yeroon.api-key, yeroon.webhook-secret e yeroon.timeout. Os
 * valores vêm de YEROON_API_URL, YEROON_API_KEY e YEROON_WEBHOOK_SECRET (só no
 * .env do back); nenhum valor de segredo mora no código nem no git.
 */
@ConfigurationProperties("yeroon")
public record YeroonProperties(URI apiUrl, String apiKey, String webhookSecret, Duration timeout) {

    private static final URI DEFAULT_API_URL = URI.create("https://api.dev.play.yeroon.video");
    private static final Duration DEFAULT_TIMEOUT = Duration.ofSeconds(10);

    public YeroonProperties {
        if (apiUrl == null) {
            apiUrl = DEFAULT_API_URL;
        }
        if (timeout == null) {
            timeout = DEFAULT_TIMEOUT;
        }
    }
}
