import { renderRouter, screen } from "expo-router/testing-library";
import { API_BASE } from "@/lib/api";
import VideoScreen from "@/app/videos/[id]";

jest.mock("expo-video", () => {
  const { View } = require("react-native");
  return {
    useVideoPlayer: jest.fn((source: string) => ({ source, play: jest.fn(), addListener: jest.fn(() => ({ remove: jest.fn() })) })),
    VideoView: () => <View testID="video-view" />,
  };
});

const ID = "3f1c2e4a-5b6d-4e7f-8a9b-0c1d2e3f4a5b";

test("a rota /videos/[id] abre o player do id da URL", async () => {
  const urls: string[] = [];
  globalThis.fetch = jest.fn(async (input: RequestInfo | URL) => {
    urls.push(String(input));
    return new Response(JSON.stringify({ videoId: ID, fileName: "aula.mp4", status: "PROCESSANDO", failureReason: null }), {
      status: 200,
      headers: { "content-type": "application/json" },
    });
  }) as typeof fetch;

  await renderRouter({ "videos/[id]": VideoScreen }, { initialUrl: `/videos/${ID}` });
  expect(await screen.findByText("aula.mp4")).toBeTruthy();
  expect(urls[0]).toBe(`${API_BASE}/videos/${ID}`);
});
