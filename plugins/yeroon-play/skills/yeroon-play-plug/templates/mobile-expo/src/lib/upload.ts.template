import { File, FileMode, Paths } from "expo-file-system";
import { API_BASE, InvalidVideoIdError, ensureOk, isVideoId, videoUrl } from "@/lib/api";

/** Arquivo local escolhido pela pessoa (o `DocumentPickerAsset` do expo-document-picker serve como está). */
export type LocalVideoFile = { uri: string; name: string; size: number; mimeType?: string | null };

/** Onde fica o upload pendente (para retomar depois de fechar o app). */
export type PendingUploadStore = {
  get(key: string): Promise<string | null>;
  set(key: string, value: string): Promise<void>;
  remove(key: string): Promise<void>;
};

export type UploadOptions = {
  signal?: AbortSignal;
  fetchImpl?: typeof fetch;
  /** Lê `length` bytes a partir de `offset`. Padrão: `FileHandle` do expo-file-system. */
  readPart?: (uri: string, offset: number, length: number) => Promise<Uint8Array<ArrayBuffer>>;
  store?: PendingUploadStore;
  /** Espera antes de cada nova tentativa de uma parte; o tamanho da lista é o número de novas tentativas. */
  retryDelaysMs?: number[];
};

/** O início do upload foi recusado por regra de negócio (422): reenviar o mesmo arquivo não adianta. */
export class UploadRejectedError extends Error {
  constructor(message: string) {
    super(message);
    this.name = "UploadRejectedError";
  }
}

type Part = { partNumber: number; etag: string };
type Plan = { videoId: string; partSize: number; partCount: number; done: Part[] };

// Cada parte em envio fica inteira na memória: no celular, poucas de cada vez.
const CONCURRENCY = 2;
const URL_BATCH = 20;
const BACKOFF_MS = [500, 1000, 2000];

function abortError(): Error {
  const e = new Error("Upload cancelado");
  e.name = "AbortError";
  return e;
}

const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
const globalFetch: typeof fetch = (...args) => fetch(...args);

/** Lê a faixa `[offset, offset + length)` do arquivo, sem carregar o arquivo inteiro. */
export async function readPartFromFile(uri: string, offset: number, length: number): Promise<Uint8Array<ArrayBuffer>> {
  const handle = new File(uri).open(FileMode.ReadOnly);
  try {
    handle.offset = offset;
    return await handle.readBytes(length);
  } finally {
    handle.close();
  }
}

/** Guarda os uploads pendentes num JSON na pasta de documentos do app. */
export function fileStore(fileName = "yeroon-pending-uploads.json"): PendingUploadStore {
  const file = () => new File(Paths.document, fileName);
  const read = async (): Promise<Record<string, string>> => {
    try {
      const f = file();
      return f.exists ? (JSON.parse(await f.text()) as Record<string, string>) : {};
    } catch {
      return {};
    }
  };
  const write = async (data: Record<string, string>) => {
    const f = file();
    if (!f.exists) f.create();
    await f.write(JSON.stringify(data));
  };
  return {
    get: async (key) => (await read())[key] ?? null,
    set: async (key, value) => write({ ...(await read()), [key]: value }),
    remove: async (key) => {
      const data = await read();
      delete data[key];
      await write(data);
    },
  };
}

/**
 * Envia o vídeo em partes direto para as URLs assinadas e devolve o `videoId`.
 * Retoma um envio interrompido do mesmo arquivo (nome + tamanho) pulando as partes que o back já
 * lista em `GET …/upload/parts`. Abortar o `signal` cancela no back (`DELETE …/upload`).
 */
export async function uploadVideo(
  file: LocalVideoFile,
  onProgress?: (sentParts: number, totalParts: number) => void,
  opts: UploadOptions = {},
): Promise<string> {
  const doFetch = opts.fetchImpl ?? globalFetch;
  const readPart = opts.readPart ?? readPartFromFile;
  const store = opts.store ?? fileStore();
  const delays = opts.retryDelaysMs ?? BACKOFF_MS;
  const { signal } = opts;
  const key = `upload:${file.name}:${file.size}`;
  const planKey = `${key}:plan`;

  const api = (url: string, init?: RequestInit) => doFetch(url, { ...init, signal });
  const jsonInit = (method: string, body: unknown): RequestInit => ({
    method,
    headers: { "content-type": "application/json" },
    body: JSON.stringify(body),
  });
  const clearKeys = async () => {
    await store.remove(key);
    await store.remove(planKey);
  };

  const startNew = async (): Promise<Plan> => {
    const initRes = await api(
      `${API_BASE}/videos/uploads`,
      jsonInit("POST", {
        fileName: file.name,
        contentType: file.mimeType || "application/octet-stream",
        sizeBytes: file.size,
      }),
    );
    if (initRes.status === 422) {
      let messages: string[] = [];
      try {
        const problem = (await initRes.json()) as { errors?: { message?: string }[] };
        messages = (problem.errors ?? []).flatMap((e) => (e.message ? [e.message] : []));
      } catch {
        // corpo fora do padrão: cai na mensagem genérica abaixo
      }
      throw new UploadRejectedError(messages.join(" ") || "O servidor recusou o arquivo.");
    }
    const body = (await (await ensureOk(initRes)).json()) as {
      videoId: string;
      partSizeBytes: number;
      partCount: number;
    };
    if (!isVideoId(body.videoId)) throw new InvalidVideoIdError();
    await store.set(key, body.videoId);
    await store.set(planKey, JSON.stringify({ partSize: body.partSizeBytes }));
    return { videoId: body.videoId, partSize: body.partSizeBytes, partCount: body.partCount, done: [] };
  };

  const resume = async (savedId: string): Promise<Plan | null> => {
    if (!isVideoId(savedId)) {
      await clearKeys();
      return null;
    }
    const res = await api(videoUrl(savedId, "/upload/parts"));
    if (res.status === 404 || res.status === 422) {
      await clearKeys();
      return null;
    }
    await ensureOk(res);
    const body = (await res.json()) as { parts: { partNumber: number; etag: string; sizeBytes: number }[] };
    // O GET /parts não informa o tamanho da parte: usa o plano guardado ou o maior tamanho já enviado.
    let partSize = 0;
    try {
      partSize = JSON.parse((await store.get(planKey)) ?? "null")?.partSize ?? 0;
    } catch {
      partSize = 0;
    }
    if (!partSize) partSize = Math.max(0, ...body.parts.map((p) => p.sizeBytes));
    if (!partSize) {
      // Nada enviado e plano desconhecido: descarta e recomeça.
      await api(videoUrl(savedId, "/upload"), { method: "DELETE" });
      await clearKeys();
      return null;
    }
    return {
      videoId: savedId,
      partSize,
      partCount: Math.ceil(file.size / partSize),
      done: body.parts.map((p) => ({ partNumber: p.partNumber, etag: p.etag })),
    };
  };

  const saved = await store.get(key);
  const plan = (saved ? await resume(saved) : null) ?? (await startNew());
  const { videoId, partSize, partCount } = plan;
  const parts = new Map<number, string>(plan.done.map((p) => [p.partNumber, p.etag]));
  onProgress?.(parts.size, partCount);

  const cancel = async (): Promise<never> => {
    try {
      await doFetch(videoUrl(videoId, "/upload"), { method: "DELETE" });
    } finally {
      await clearKeys();
    }
    throw abortError();
  };

  const putPart = async (n: number, url: string) => {
    const offset = (n - 1) * partSize;
    const bytes = await readPart(file.uri, offset, Math.min(partSize, file.size - offset));
    for (let attempt = 0; ; attempt++) {
      if (signal?.aborted) throw abortError();
      try {
        const res = await doFetch(url, {
          method: "PUT",
          headers: { "content-type": "application/octet-stream" },
          body: bytes,
          signal,
        });
        if (!res.ok) throw new Error(`PUT da parte ${n} falhou (${res.status})`);
        const etag = res.headers.get("ETag");
        if (!etag) throw new Error(`Parte ${n} sem ETag na resposta`);
        parts.set(n, etag);
        onProgress?.(parts.size, partCount);
        return;
      } catch (e) {
        if (signal?.aborted || (e as Error).name === "AbortError") throw abortError();
        if (attempt >= delays.length) throw e;
        await sleep(delays[attempt]);
      }
    }
  };

  const missing: number[] = [];
  for (let n = 1; n <= partCount; n++) if (!parts.has(n)) missing.push(n);

  try {
    for (let i = 0; i < missing.length; i += URL_BATCH) {
      const batch = missing.slice(i, i + URL_BATCH);
      const res = await ensureOk(await api(videoUrl(videoId, "/upload/part-urls"), jsonInit("POST", { partNumbers: batch })));
      const { urls } = (await res.json()) as { urls: { partNumber: number; url: string }[] };
      const queue = [...urls];
      const worker = async () => {
        for (let next = queue.shift(); next; next = queue.shift()) {
          await putPart(next.partNumber, next.url);
        }
      };
      await Promise.all(Array.from({ length: Math.min(CONCURRENCY, queue.length) }, worker));
    }
    if (signal?.aborted) throw abortError();
    await ensureOk(
      await api(
        videoUrl(videoId, "/upload/complete"),
        jsonInit("POST", {
          parts: [...parts.entries()]
            .sort(([a], [b]) => a - b)
            .map(([partNumber, etag]) => ({ partNumber, etag })),
        }),
      ),
    );
  } catch (e) {
    if (signal?.aborted || (e as Error).name === "AbortError") return cancel();
    throw e;
  }
  await clearKeys();
  return videoId;
}
