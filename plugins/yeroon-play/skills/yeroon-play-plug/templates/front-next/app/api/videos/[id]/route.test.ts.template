import { afterEach, expect, test, vi } from "vitest";
import { DELETE, GET } from "./route";

afterEach(() => vi.unstubAllGlobals());

const UUID = "0b9f6a1e-3c2d-4e5f-8a7b-1c2d3e4f5a6b";
const ctx = (id: string) => ({ params: Promise.resolve({ id }) }) as never;

test("deleteRepassaOMetodoDeleteParaOBackEDevolve204", async () => {
  const fetchMock = vi.fn(async () => new Response(null, { status: 204 }));
  vi.stubGlobal("fetch", fetchMock);
  const res = await DELETE(
    new Request("http://localhost:3000/api/videos/x", { method: "DELETE" }),
    ctx(UUID),
  );
  expect(res.status).toBe(204);
  const [url, init] = fetchMock.mock.calls[0] as unknown as [string, RequestInit];
  expect(url).toBe(`http://localhost:8080{context-path}{api-routes-prefix}/videos/${UUID}`);
  expect(init.method).toBe("DELETE");
});

test("deleteRepassaO422DoBackComOCorpo", async () => {
  const body = '{"errors":[{"code":"video.deletable"}]}';
  vi.stubGlobal(
    "fetch",
    vi.fn(
      async () =>
        new Response(body, {
          status: 422,
          headers: { "content-type": "application/problem+json" },
        }),
    ),
  );
  const res = await DELETE(
    new Request("http://localhost:3000/api/videos/x", { method: "DELETE" }),
    ctx(UUID),
  );
  expect(res.status).toBe(422);
  expect(await res.text()).toBe(body);
});

test("idQueNaoEUuidRecebe400ENuncaChegaAoBack", async () => {
  const fetchMock = vi.fn(async () => new Response("{}", { status: 200 }));
  vi.stubGlobal("fetch", fetchMock);
  for (const id of ["..", ".", "", "a/b", "a?b"]) {
    expect((await GET(new Request("http://localhost:3000/api/videos/x"), ctx(id))).status).toBe(400);
    expect(
      (await DELETE(new Request("http://localhost:3000/api/videos/x", { method: "DELETE" }), ctx(id))).status,
    ).toBe(400);
  }
  expect(fetchMock).not.toHaveBeenCalled();
});

test("uuidValidoVaiParaOBack", async () => {
  const fetchMock = vi.fn(async () => new Response("{}", { status: 200 }));
  vi.stubGlobal("fetch", fetchMock);
  await GET(new Request("http://localhost:3000/api/videos/x"), ctx(UUID));
  const [url] = fetchMock.mock.calls[0] as unknown as [string];
  expect(url).toBe(`http://localhost:8080{context-path}{api-routes-prefix}/videos/${UUID}`);
});
