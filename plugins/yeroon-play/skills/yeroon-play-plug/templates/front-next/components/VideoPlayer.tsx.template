"use client";

import { useEffect, useState } from "react";
import { statusLabel } from "@/lib/videoStatus";

// Estados finais: nada mais muda, então a consulta para.
const TERMINAL = ["PRONTO", "FALHOU", "CANCELADO", "ABANDONADO"];

type Detail = { status: string; fileName: string; failureReason: string | null };

/**
 * Acompanha o status do vídeo e, quando PRONTO, pede um token de reprodução novo e abre o player
 * em `<iframe>`. O token vale por tempo limitado: é pedido a cada abertura e nunca guardado.
 */
export function VideoPlayer({ id }: { id: string }) {
  const [detail, setDetail] = useState<Detail | null>(null);
  const [error, setError] = useState(false);
  const [embedUrl, setEmbedUrl] = useState<string | null>(null);
  const [playerError, setPlayerError] = useState(false);
  const finished = detail !== null && TERMINAL.includes(detail.status);
  const safeId = encodeURIComponent(id);
  const ready = detail?.status === "PRONTO";

  useEffect(() => {
    if (finished) return;
    let cancelled = false;
    const load = async () => {
      try {
        const res = await fetch(`/api/videos/${safeId}`);
        if (!res.ok) throw new Error(String(res.status));
        const body = (await res.json()) as Detail;
        if (!cancelled) {
          setDetail(body);
          setError(false);
        }
      } catch {
        if (!cancelled) setError(true);
      }
    };
    void load();
    const timer = setInterval(load, 5000);
    return () => {
      cancelled = true;
      clearInterval(timer);
    };
  }, [safeId, finished]);

  useEffect(() => {
    if (!ready) return;
    let cancelled = false;
    (async () => {
      try {
        const res = await fetch(`/api/videos/${safeId}/playback`, { method: "POST" });
        if (!res.ok) throw new Error(String(res.status));
        const body = (await res.json()) as { embedUrl: string };
        if (!cancelled) setEmbedUrl(body.embedUrl);
      } catch {
        if (!cancelled) setPlayerError(true);
      }
    })();
    return () => {
      cancelled = true;
    };
  }, [safeId, ready]);

  // O player avisa a página por postMessage; só vale mensagem vinda da origem do embedUrl.
  useEffect(() => {
    if (!embedUrl) return;
    let origin: string;
    try {
      origin = new URL(embedUrl).origin;
    } catch {
      return;
    }
    const onMessage = (event: MessageEvent) => {
      if (event.origin !== origin) return;
      const data = event.data as { source?: string; type?: string } | null;
      if (data?.source === "yeroon-player" && data.type === "error") setPlayerError(true);
    };
    window.addEventListener("message", onMessage);
    return () => window.removeEventListener("message", onMessage);
  }, [embedUrl]);

  if (!detail) {
    return <p className="video-player__message">{error ? "Vídeo não encontrado." : "Carregando…"}</p>;
  }
  return (
    <section aria-label="Vídeo em reprodução" className="video-player">
      {ready && embedUrl && !playerError ? (
        <iframe
          title="Player"
          src={ embedUrl }
          allow="autoplay; fullscreen; picture-in-picture"
          allowFullScreen
          className="video-player__frame"
        />
      ) : (
        <div className="video-player__placeholder">
          {detail.status === "FALHOU" ? (
            <p role="alert">Falha no processamento: { detail.failureReason }</p>
          ) : playerError ? (
            <p role="alert">Não foi possível tocar o vídeo.</p>
          ) : (
            <>
              <span>{statusLabel(detail.status).toUpperCase()}</span>
              <p>O vídeo aparece aqui assim que a conversão terminar.</p>
            </>
          )}
        </div>
      )}
      <h1 className="video-player__title">{ detail.fileName }</h1>
      <p className="video-player__status">Status: {statusLabel(detail.status)}</p>
    </section>
  );
}
