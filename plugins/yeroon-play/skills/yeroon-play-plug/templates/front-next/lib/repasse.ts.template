const PASSTHROUGH_HEADERS = ["content-type", "cache-control"];

/** Caminho do back sob o qual ficam as rotas de vídeo: context-path + prefixo de mapeamento. */
const BACK_PREFIX = "{context-path}{api-routes-prefix}";

/**
 * Repassa a requisição ao back do projeto e devolve status, corpo, content-type e cache-control.
 * `path` começa em `/videos`; o prefixo do back é acrescentado aqui. A URL do back vem da
 * variável de ambiente `{back-url-env}`, lida só no servidor — o navegador nunca a vê.
 */
export async function repasse(request: Request, path: string): Promise<Response> {
  const base = (process.env.{back-url-env} || "http://localhost:8080").replace(/\/+$/, "");
  const method = request.method;
  const hasBody = method !== "GET" && method !== "HEAD";
  const headers: Record<string, string> = {};
  const contentType = request.headers.get("content-type");
  if (hasBody && contentType) headers["content-type"] = contentType;

  let upstream: Response;
  try {
    upstream = await fetch(`${base}${BACK_PREFIX}${path}`, {
      method,
      headers,
      body: hasBody ? await request.text() : undefined,
      cache: "no-store",
    });
  } catch {
    return generic(502, "Não foi possível falar com o servidor.");
  }
  // Erro do servidor do back não vaza para o navegador: mesmo status, corpo genérico.
  if (upstream.status >= 500) return generic(upstream.status, "Erro no servidor.");

  const out = new Headers();
  for (const name of PASSTHROUGH_HEADERS) {
    const value = upstream.headers.get(name);
    if (value) out.set(name, value);
  }
  const noBody = upstream.status === 204 || upstream.status === 304;
  return new Response(noBody ? null : await upstream.arrayBuffer(), {
    status: upstream.status,
    headers: out,
  });
}

function generic(status: number, title: string): Response {
  return Response.json({ title }, { status });
}
