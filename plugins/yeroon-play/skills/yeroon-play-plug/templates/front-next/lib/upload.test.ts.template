import { afterEach, describe, expect, test, vi } from "vitest";
import { UploadRejectedError, uploadVideo } from "./upload";

type Call = { method: string; url: string; body?: unknown };
type Sent = { method: string; url: string; headers: Record<string, string>; credentials?: RequestCredentials };

function memoryStorage(initial: Record<string, string> = {}): Storage {
  const data = new Map(Object.entries(initial));
  return {
    get length() {
      return data.size;
    },
    clear: () => data.clear(),
    getItem: (k: string) => data.get(k) ?? null,
    key: (i: number) => [...data.keys()][i] ?? null,
    removeItem: (k: string) => void data.delete(k),
    setItem: (k: string, v: string) => void data.set(k, v),
  };
}

const json = (body: unknown, status = 200) =>
  new Response(JSON.stringify(body), {
    status,
    headers: { "content-type": "application/json" },
  });

function fakeApi(opts: {
  existingParts?: number[];
  partsStatus?: number;
  initResponse?: Response;
  putHook?: (partNumber: number, attempt: number) => Response | void;
}) {
  const calls: Call[] = [];
  const sent: Sent[] = [];
  const putAttempts = new Map<number, number>();
  const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
    const url = String(input);
    const method = init?.method ?? "GET";
    const body =
      typeof init?.body === "string" ? JSON.parse(init.body) : init?.body;
    calls.push({ method, url, body });
    sent.push({
      method,
      url,
      headers: Object.fromEntries(new Headers(init?.headers).entries()),
      credentials: init?.credentials,
    });
    if (method === "POST" && url === "/api/videos/uploads") {
      if (opts.initResponse) return opts.initResponse;
      return json({ videoId: "v1", partSizeBytes: 10, partCount: 3 }, 201);
    }
    if (method === "GET" && url === "/api/videos/v1/upload/parts") {
      if (opts.partsStatus) return json({ title: "x" }, opts.partsStatus);
      return json({
        parts: (opts.existingParts ?? []).map((n) => ({
          partNumber: n,
          etag: `"e${n}"`,
          sizeBytes: 10,
        })),
      });
    }
    if (method === "POST" && url === "/api/videos/v1/upload/part-urls") {
      return json({
        urls: body.partNumbers.map((n: number) => ({
          partNumber: n,
          url: `http://minio/put/${n}`,
        })),
      });
    }
    if (method === "PUT") {
      const n = Number(url.split("/").pop());
      const attempt = (putAttempts.get(n) ?? 0) + 1;
      putAttempts.set(n, attempt);
      const custom = opts.putHook?.(n, attempt);
      if (custom) return custom;
      return new Response(null, { status: 200, headers: { ETag: `"e${n}"` } });
    }
    if (method === "POST" && url === "/api/videos/v1/upload/complete") {
      return json({ videoId: "v1", status: "ENVIADO" });
    }
    if (method === "DELETE" && url === "/api/videos/v1/upload") {
      return new Response(null, { status: 204 });
    }
    throw new Error(`chamada inesperada ${method} ${url}`);
  }) as typeof fetch;
  // O dublê serve também de storage: os testes o passam como `putFetch` (o PUT nunca usa o `fetchImpl`).
  return { calls, sent, fetchImpl, putFetch: fetchImpl };
}

const file = new File(["x".repeat(25)], "a.mp4", {
  type: "video/mp4",
  lastModified: 1,
});
const key = "upload:a.mp4:25:1";

describe("uploadVideo", () => {
  test("enviaTodasAsPartesECompletaComOsETags", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({});
    const storage = memoryStorage();
    const progress: number[] = [];
    const r = await uploadVideo(file, {
      fetchImpl,
      putFetch,
      storage,
      onProgress: (sent) => progress.push(sent),
    });
    expect(r).toEqual({ videoId: "v1" });
    expect(calls.filter((c) => c.method === "PUT")).toHaveLength(3);
    const complete = calls.find((c) => c.url.endsWith("/upload/complete"));
    expect(complete?.body).toEqual({
      parts: [
        { partNumber: 1, etag: '"e1"' },
        { partNumber: 2, etag: '"e2"' },
        { partNumber: 3, etag: '"e3"' },
      ],
    });
    expect(storage.getItem(key)).toBeNull();
    expect(progress.at(-1)).toBe(3);
  });

  test("retomaEnviandoSoAsPartesQueFaltam", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({ existingParts: [1, 2] });
    const storage = memoryStorage({ [key]: "v1" });
    await uploadVideo(file, { fetchImpl, putFetch, storage });
    expect(calls.some((c) => c.url === "/api/videos/uploads")).toBe(false);
    const puts = calls.filter((c) => c.method === "PUT");
    expect(puts.map((c) => c.url)).toEqual(["http://minio/put/3"]);
    const complete = calls.find((c) => c.url.endsWith("/upload/complete"));
    expect(
      (complete?.body as { parts: { partNumber: number }[] }).parts.map(
        (p) => p.partNumber,
      ),
    ).toEqual([1, 2, 3]);
  });

  test("videoNaoMaisPendenteApagaAChaveEComecaDoZero", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({ partsStatus: 422 });
    const storage = memoryStorage({ [key]: "v1" });
    await uploadVideo(file, { fetchImpl, putFetch, storage });
    expect(calls.some((c) => c.url === "/api/videos/uploads")).toBe(true);
  });

  test("inicioRecusadoCom422TrazAsMensagensDoServidor", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({
      initResponse: json(
        {
          title: "Regra de negocio violada",
          errors: [{ id: "video.content-type", message: "Só vídeos são aceitos." }],
        },
        422,
      ),
    });
    const err = await uploadVideo(file, { fetchImpl, putFetch, storage: memoryStorage() }).catch((e) => e);
    expect(err).toBeInstanceOf(UploadRejectedError);
    expect((err as Error).message).toBe("Só vídeos são aceitos.");
    expect(calls.some((c) => c.url.endsWith("/part-urls"))).toBe(false);
  });

  test("arquivoComTamanhoDiferenteComecaUploadNovo", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({});
    const storage = memoryStorage({ "upload:a.mp4:99:1": "v1" });
    await uploadVideo(file, { fetchImpl, putFetch, storage });
    expect(calls.some((c) => c.url === "/api/videos/uploads")).toBe(true);
    expect(calls.some((c) => c.url.endsWith("/upload/parts"))).toBe(false);
  });

  test("tentaDeNovoUmaParteQueFalhou", async () => {
    const { calls, fetchImpl, putFetch } = fakeApi({
      putHook: (n, attempt) =>
        n === 2 && attempt === 1 ? new Response(null, { status: 500 }) : undefined,
    });
    await uploadVideo(file, { fetchImpl, putFetch, storage: memoryStorage() });
    expect(
      calls.filter((c) => c.method === "PUT" && c.url.endsWith("/2")),
    ).toHaveLength(2);
    expect(calls.some((c) => c.url.endsWith("/upload/complete"))).toBe(true);
  });

  test("cancelarAbortaNoBackend", async () => {
    const controller = new AbortController();
    const { calls, fetchImpl, putFetch } = fakeApi({
      putHook: () => {
        controller.abort();
      },
    });
    const storage = memoryStorage();
    await expect(
      uploadVideo(file, { fetchImpl, putFetch, storage, signal: controller.signal }),
    ).rejects.toMatchObject({ name: "AbortError" });
    expect(
      calls.some((c) => c.method === "DELETE" && c.url === "/api/videos/v1/upload"),
    ).toBe(true);
    expect(calls.some((c) => c.url.endsWith("/upload/complete"))).toBe(false);
    expect(storage.getItem(key)).toBeNull();
  });
});

describe("uploadVideo com videoId fora do comum", () => {
  test("codificaOVideoIdNasUrls", async () => {
    const calls: string[] = [];
    const fetchImpl = (async (input: RequestInfo | URL, init?: RequestInit) => {
      const url = String(input);
      calls.push(`${init?.method ?? "GET"} ${url}`);
      if (url === "/api/videos/uploads") return json({ videoId: "a/b", partSizeBytes: 100, partCount: 1 }, 201);
      if (url.endsWith("/part-urls")) return json({ urls: [{ partNumber: 1, url: "http://minio/put/1" }] });
      if (init?.method === "PUT") return new Response(null, { status: 200, headers: { ETag: '"e1"' } });
      return json({ videoId: "a/b", status: "ENVIADO" });
    }) as typeof fetch;
    await uploadVideo(file, { fetchImpl, putFetch: fetchImpl, storage: memoryStorage() });
    expect(calls).toContain("POST /api/videos/a%2Fb/upload/part-urls");
    expect(calls).toContain("POST /api/videos/a%2Fb/upload/complete");
  });
});

describe("uploadVideo e a autenticação do app", () => {
  afterEach(() => vi.unstubAllGlobals());

  // O projeto pode injetar a autenticação do app no fetch das rotas; ela não pode chegar ao storage.
  const authed = (api: ReturnType<typeof fakeApi>) =>
    ((input: RequestInfo | URL, init?: RequestInit) =>
      api.fetchImpl(input, {
        ...init,
        headers: { ...(init?.headers as Record<string, string>), Authorization: "Bearer app-token", Cookie: "s=1" },
      })) as typeof fetch;

  test("putDasPartesNuncaUsaOFetchAutenticadoDasRotas", async () => {
    const api = fakeApi({});
    const storage = fakeApi({});
    vi.stubGlobal("fetch", storage.putFetch);
    // Sem `putFetch`: o padrão é o `fetch` global, nunca o `fetchImpl`.
    await uploadVideo(file, { fetchImpl: authed(api), storage: memoryStorage() });
    expect(api.calls.some((c) => c.method === "PUT")).toBe(false);
    const puts = storage.sent.filter((s) => s.method === "PUT");
    expect(puts).toHaveLength(3);
    for (const put of puts) {
      expect(put.headers).toEqual({ "content-type": "application/octet-stream" });
      expect(put.credentials).toBe("omit");
    }
    expect(api.sent.length).toBeGreaterThan(0);
    for (const call of api.sent) expect(call.headers.authorization).toBe("Bearer app-token");
  });

  test("putFetchInjetadoTambemNaoRecebeAuthorization", async () => {
    const api = fakeApi({});
    const storage = fakeApi({
      putHook: (n, attempt) => (n === 2 && attempt === 1 ? new Response(null, { status: 500 }) : undefined),
    });
    await uploadVideo(file, { fetchImpl: authed(api), putFetch: storage.putFetch, storage: memoryStorage() });
    const puts = storage.sent.filter((s) => s.method === "PUT");
    expect(puts).toHaveLength(4); // 3 partes + 1 nova tentativa
    for (const put of puts) {
      expect(put.headers).not.toHaveProperty("authorization");
      expect(put.headers).not.toHaveProperty("cookie");
    }
  });
});
