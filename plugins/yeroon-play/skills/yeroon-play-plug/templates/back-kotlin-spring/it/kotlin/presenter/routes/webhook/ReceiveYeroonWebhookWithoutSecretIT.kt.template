package {base-package}.presenter.routes.webhook

import {base-package}.support.YeroonIntegrationTest
import java.time.Instant
import java.util.HexFormat
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import org.junit.jupiter.api.Test
import org.springframework.http.MediaType
import org.springframework.test.context.TestPropertySource

/** Sem YEROON_WEBHOOK_SECRET configurado, o webhook recusa tudo — mesmo aviso bem assinado. */
@TestPropertySource(properties = ["yeroon.webhook-secret="])
class ReceiveYeroonWebhookWithoutSecretIT : YeroonIntegrationTest() {

    @Test
    fun semSegredoConfiguradoResponde401() {
        val body = """{"id":"evt-1","type":"video.ready","data":{"videoId":"11111111-1111-1111-1111-111111111111"}}"""
            .toByteArray()
        val t = Instant.now().epochSecond
        val mac = Mac.getInstance("HmacSHA256")
        mac.init(SecretKeySpec(WEBHOOK_SECRET.toByteArray(), "HmacSHA256"))
        mac.update("$t.".toByteArray())
        val signature = "t=$t,v1=" + HexFormat.of().formatHex(mac.doFinal(body))

        api.post().uri("{api-routes-prefix}/webhooks/yeroon")
            .contentType(MediaType.APPLICATION_JSON)
            .header("X-Yeroon-Event", "video.ready")
            .header("X-Yeroon-Delivery", "evt-1")
            .header("X-Yeroon-Signature", signature)
            .body(body)
            .exchange()
            .expectStatus().isUnauthorized()
    }
}
