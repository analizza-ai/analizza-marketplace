package {base-package}.infrastructure

import {base-package}.domain.{video-entity}
import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.domain.repositories.WebhookReceiptRepository
import {base-package}.support.YeroonIntegrationTest
import java.time.Instant
import java.util.UUID
import org.junit.jupiter.api.Assertions.assertFalse
import org.junit.jupiter.api.Assertions.assertTrue
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows
import org.springframework.beans.factory.annotation.Autowired

class YeroonRepositoriesIT : YeroonIntegrationTest() {

    @Autowired
    private lateinit var videos: {video-entity}Repository

    @Autowired
    private lateinit var receipts: WebhookReceiptRepository

    @Test
    fun salvaListaEApagaOsIds() {
        val a = UUID.randomUUID()
        val b = UUID.randomUUID()
        videos.save({video-entity}.register(a, Instant.now()))
        videos.save({video-entity}.register(b, Instant.now()))

        assertTrue(videos.findAllIds().containsAll(setOf(a, b)))
        videos.deleteById(a)
        assertFalse(videos.existsById(a))
        assertTrue(videos.existsById(b))
    }

    @Test
    fun reciboSoEntraNaPrimeiraVez() {
        val delivery = "delivery-${UUID.randomUUID()}"
        val video = UUID.randomUUID()

        assertTrue(receipts.registerIfNew(delivery, "video.ready", video, Instant.now()))
        assertFalse(receipts.registerIfNew(delivery, "video.ready", video, Instant.now()))
    }

    @Test
    fun falhaQueNaoEDuplicidadeNaoViraJaRecebido() {
        // Em Kotlin o tipo já barra eventType nulo; valor longo demais é a
        // violação que sobra para provar que só a chave repetida vira "já recebido".
        assertThrows<RuntimeException> {
            receipts.registerIfNew("x".repeat(500), "video.ready", UUID.randomUUID(), Instant.now())
        }
        assertThrows<RuntimeException> {
            receipts.registerIfNew("delivery-${UUID.randomUUID()}", "y".repeat(500), UUID.randomUUID(), Instant.now())
        }
    }
}
