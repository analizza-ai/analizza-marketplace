// TRECHO — só se o projeto usa spring-security; sem ela, ignore este arquivo.
//   Mescle na SecurityFilterChain que o projeto JÁ tem (não crie uma segunda cadeia
//   para as mesmas URLs). O webhook não tem login: a autenticação dele é a
//   assinatura HMAC, então precisa de permitAll e de ficar fora do CSRF. As rotas
//   {api-routes-prefix}/videos/** seguem as regras de autenticação que o projeto
//   já aplica às outras rotas. Os matchers não levam o context-path.
//   Imports: org.springframework.http.HttpMethod,
//   org.springframework.security.config.annotation.web.builders.HttpSecurity,
//   org.springframework.security.web.SecurityFilterChain.

    @Bean
    fun securityFilterChain(http: HttpSecurity): SecurityFilterChain {
        http
            // yeroon play: o webhook é chamado por servidor, sem cookie nem token CSRF.
            .csrf { it.ignoringRequestMatchers("{api-routes-prefix}/webhooks/yeroon") }
            .authorizeHttpRequests {
                it
                    // yeroon play: antes das regras mais amplas, ou elas ganham.
                    .requestMatchers(HttpMethod.POST, "{api-routes-prefix}/webhooks/yeroon").permitAll()
                    // ... regras que o projeto já tem (as de {api-routes-prefix}/videos/** entram aqui)
                    .anyRequest().authenticated()
            }
        return http.build()
    }
