package {base-package}.presenter.configuration.security

import java.security.GeneralSecurityException
import java.security.MessageDigest
import java.time.Instant
import java.util.HexFormat
import javax.crypto.Mac
import javax.crypto.spec.SecretKeySpec
import kotlin.math.abs

/**
 * Confere o X-Yeroon-Signature: `t=<epoch>,v1=hex(HMAC-SHA256(segredo, "<epoch>." + corpo bruto))`.
 * O corpo entra como bytes, exatamente como chegou: re-serializar o JSON mudaria a
 * assinatura. Comparação em tempo constante; recusa epoch fora de ±5 min e
 * recusa tudo quando não há segredo configurado.
 */
object YeroonWebhookSignature {

    private const val TOLERANCE_SECONDS = 300L

    fun verify(secret: String?, header: String?, rawBody: ByteArray?, now: Instant): Boolean {
        if (secret.isNullOrBlank() || header == null || rawBody == null) return false
        val parts = header.split(",").map { it.trim() }
        val epoch = parts.firstOrNull { it.startsWith("t=") }?.removePrefix("t=")?.toLongOrNull() ?: return false
        val provided = parts.firstOrNull { it.startsWith("v1=") }?.removePrefix("v1=")
            ?.let { runCatching { HexFormat.of().parseHex(it) }.getOrNull() } ?: return false
        if (abs(now.epochSecond - epoch) > TOLERANCE_SECONDS) return false
        return try {
            val mac = Mac.getInstance("HmacSHA256")
            mac.init(SecretKeySpec(secret.toByteArray(), "HmacSHA256"))
            mac.update("$epoch.".toByteArray())
            MessageDigest.isEqual(mac.doFinal(rawBody), provided)
        } catch (e: GeneralSecurityException) {
            false
        }
    }
}
