package {base-package}.presenter.routes.video.completeUpload

import {base-package}.application.video.completeUpload.CompleteUploadCommand
import {base-package}.application.video.completeUpload.CompleteUploadHandler
import {base-package}.application.video.completeUpload.CompleteUploadResult
import java.util.UUID
import org.springframework.web.bind.annotation.PathVariable
import org.springframework.web.bind.annotation.PostMapping
import org.springframework.web.bind.annotation.RequestBody
import org.springframework.web.bind.annotation.RestController

@RestController
class CompleteUploadRoute(private val handler: CompleteUploadHandler) {

    data class CompleteUploadRequest(val parts: List<PartRequest>? = null)

    data class PartRequest(val partNumber: Int, val etag: String)

    @PostMapping("{api-routes-prefix}/videos/{id}/upload/complete")
    fun handle(@PathVariable id: UUID, @RequestBody request: CompleteUploadRequest): CompleteUploadResult =
        handler.handle(
            CompleteUploadCommand(id, request.parts?.map { CompleteUploadCommand.Part(it.partNumber, it.etag) }),
        )
}
