package {base-package}.infrastructure.repositories

import {base-package}.domain.{video-entity}
import jakarta.persistence.Column
import jakarta.persistence.Entity
import jakarta.persistence.Id
import jakarta.persistence.Table
import java.time.Instant
import java.util.UUID

// @field: põe a anotação no campo (acesso por campo) qualquer que seja o
// -Xannotation-default-target do módulo. O construtor sem argumentos que o
// JPA exige vem do plugin kotlin("plugin.jpa").
@Entity
@Table(name = "{video-table}")
class {video-entity}JpaEntity(
    @field:Id
    val id: UUID,

    @field:Column(name = "created_at", nullable = false)
    val createdAt: Instant,
) {
    fun toDomain(): {video-entity} = {video-entity}.restore(id, createdAt)

    companion object {
        fun fromDomain(video: {video-entity}) = {video-entity}JpaEntity(video.id, video.createdAt)
    }
}
