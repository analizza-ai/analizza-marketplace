package {base-package}.application.video.listUploadedParts

import {base-package}.domain.{video-entity}NotFoundException
import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient
import org.springframework.stereotype.Component

@Component
class ListUploadedPartsHandler(private val yeroon: YeroonClient, private val videos: {video-entity}Repository) {

    fun handle(query: ListUploadedPartsQuery): ListUploadedPartsResult {
        if (!videos.existsById(query.videoId)) throw {video-entity}NotFoundException()
        return ListUploadedPartsResult(
            yeroon.uploadedParts(query.videoId).map { ListUploadedPartsResult.Part(it.partNumber, it.etag, it.sizeBytes) },
        )
    }
}
