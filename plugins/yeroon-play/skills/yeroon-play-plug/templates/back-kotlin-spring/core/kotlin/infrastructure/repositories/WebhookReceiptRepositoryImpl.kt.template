package {base-package}.infrastructure.repositories

import {base-package}.domain.repositories.WebhookReceiptRepository
import java.time.Instant
import java.util.UUID
import org.springframework.dao.DataIntegrityViolationException
import org.springframework.stereotype.Repository

@Repository
internal class WebhookReceiptRepositoryImpl(private val jpa: WebhookReceiptJpaRepository) : WebhookReceiptRepository {

    // Sem @Transactional: o saveAndFlush roda na própria transação, e o
    // existsById depois da falha precisa de uma transação nova, não da que
    // a violação marcou para rollback.
    override fun registerIfNew(deliveryId: String, eventType: String, videoId: UUID, at: Instant): Boolean =
        try {
            jpa.saveAndFlush(WebhookReceiptJpaEntity(deliveryId, eventType, videoId, at))
            true
        } catch (e: DataIntegrityViolationException) {
            // Só a chave primária repetida é "já recebido". Qualquer outra violação
            // (valor longo demais, coluna nula) sobe: responder 200 perderia o aviso.
            if (jpa.existsById(deliveryId)) false else throw e
        }
}
