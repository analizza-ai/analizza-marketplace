package {base-package}.application.video.listVideos

import {base-package}.domain.repositories.{video-entity}Repository
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.YeroonClient
import org.springframework.stereotype.Component

@Component
class ListVideosHandler(private val yeroon: YeroonClient, private val videos: {video-entity}Repository) {

    /** A /v1 lista tudo da conta; aqui só entram os vídeos que este projeto registrou. */
    fun handle(query: ListVideosQuery): ListVideosResult {
        val own = videos.findAllIds()
        return ListVideosResult(
            yeroon.list()
                .filter { it.videoId in own }
                .map {
                    ListVideosResult.Item(
                        it.videoId, it.fileName, it.status, it.createdAt, it.thumbnailUrl?.toString(), it.sizeBytes,
                    )
                },
        )
    }
}
