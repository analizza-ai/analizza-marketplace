package {base-package}.domain

/** Campos obrigatórios ausentes na entrada: 422 com um errors[] por campo, sem chamar a /v1. */
class {video-entity}RequestInvalidException(missingFields: List<String>) :
    RuntimeException("Campos obrigatórios ausentes: $missingFields") {

    val missingFields: List<String> = missingFields.toList()

    companion object {
        /** Lança se algum valor for nulo, texto em branco ou coleção vazia. */
        fun requireFields(vararg fields: Pair<String, Any?>) {
            val missing = fields.filter { (_, value) ->
                value == null || (value is CharSequence && value.isBlank()) || (value is Collection<*> && value.isEmpty())
            }.map { it.first }
            if (missing.isNotEmpty()) throw {video-entity}RequestInvalidException(missing)
        }
    }
}
