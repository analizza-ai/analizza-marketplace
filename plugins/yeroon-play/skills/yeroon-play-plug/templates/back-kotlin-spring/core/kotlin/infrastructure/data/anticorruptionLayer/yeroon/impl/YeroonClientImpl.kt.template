package {base-package}.infrastructure.data.anticorruptionLayer.yeroon.impl

import {base-package}.infrastructure.configuration.YeroonProperties
import {base-package}.infrastructure.data.anticorruptionLayer.yeroon.*
import com.fasterxml.jackson.annotation.JsonIgnoreProperties
import java.net.http.HttpClient
import java.util.UUID
import org.slf4j.LoggerFactory
import org.springframework.http.HttpHeaders
import org.springframework.http.MediaType
import org.springframework.http.client.JdkClientHttpRequestFactory
import org.springframework.stereotype.Component
import org.springframework.web.client.RestClient
import org.springframework.web.client.RestClientException
import org.springframework.web.client.RestClientResponseException
import org.springframework.web.client.body

/**
 * Cliente da /v1 do yeroon play: timeout curto, `Authorization: Bearer` e o
 * mapa de erros do contrato — 422 repassa errors[], 404 e 409 seguem, e 401,
 * 5xx, rede ou timeout viram [YeroonUnavailableException] (502 genérico).
 * Do segredo, o log só leva o prefixo da chave.
 */
@Component
class YeroonClientImpl(properties: YeroonProperties) : YeroonClient {

    private val keyPrefix: String
    private val http: RestClient

    init {
        val key = properties.apiKey?.trim().orEmpty()
        // Chave curta demais para ter prefixo seguro: loga só o tamanho.
        keyPrefix = if (key.length <= 7) "(${key.length} caracteres)" else key.take(7) + "…"
        if (key.isEmpty()) {
            log.warn("YEROON_API_KEY (yeroon.api-key) está vazia: toda chamada ao yeroon play será recusada.")
        }
        val jdk = HttpClient.newBuilder().connectTimeout(properties.timeout).build()
        val factory = JdkClientHttpRequestFactory(jdk).apply { setReadTimeout(properties.timeout) }
        http = RestClient.builder()
            .baseUrl(properties.apiUrl.toString())
            .requestFactory(factory)
            .defaultHeader(HttpHeaders.AUTHORIZATION, "Bearer $key")
            .build()
    }

    override fun initUpload(fileName: String, contentType: String, sizeBytes: Long): YeroonUpload = call {
        http.post()
            .uri("/v1/videos/uploads")
            .contentType(MediaType.APPLICATION_JSON)
            .body(mapOf("fileName" to fileName, "contentType" to contentType, "sizeBytes" to sizeBytes))
            .retrieve()
            .body<YeroonUpload>()
    }

    override fun partUrls(videoId: UUID, partNumbers: List<Int>): List<YeroonPartUrl> = call {
        http.post()
            .uri("/v1/videos/{id}/upload/part-urls", videoId)
            .contentType(MediaType.APPLICATION_JSON)
            .body(mapOf("partNumbers" to partNumbers))
            .retrieve()
            .body<Urls>()
    }.urls

    override fun uploadedParts(videoId: UUID): List<YeroonUploadedPart> = call {
        http.get().uri("/v1/videos/{id}/upload/parts", videoId).retrieve().body<Parts>()
    }.parts

    override fun complete(videoId: UUID, parts: List<YeroonPart>): YeroonCompleted = call {
        http.post()
            .uri("/v1/videos/{id}/upload/complete", videoId)
            .contentType(MediaType.APPLICATION_JSON)
            .body(mapOf("parts" to parts))
            .retrieve()
            .body<YeroonCompleted>()
    }

    override fun cancel(videoId: UUID) {
        call { http.delete().uri("/v1/videos/{id}/upload", videoId).retrieve().toBodilessEntity() }
    }

    override fun get(videoId: UUID): YeroonVideo = call {
        http.get().uri("/v1/videos/{id}", videoId).retrieve().body<YeroonVideo>()
    }

    override fun list(): List<YeroonVideoSummary> = call {
        http.get().uri("/v1/videos").retrieve().body<Videos>()
    }.videos

    override fun playbackToken(videoId: UUID): YeroonPlayback = call {
        http.post().uri("/v1/videos/{id}/playback-token", videoId).retrieve().body<YeroonPlayback>()
    }

    override fun delete(videoId: UUID) {
        call { http.delete().uri("/v1/videos/{id}", videoId).retrieve().toBodilessEntity() }
    }

    /** Executa a chamada e traduz o erro; corpo vazio onde se esperava um é falha da /v1. */
    private fun <T : Any> call(request: () -> T?): T {
        val result = try {
            request()
        } catch (e: RestClientResponseException) {
            throw map(e)
        } catch (e: RestClientException) {
            // Rede, timeout ou corpo ilegível. Só a classe da exceção vai ao log:
            // a mensagem pode citar a URL, e nada de cabeçalho nem chave.
            log.warn("yeroon play indisponível ({})", e.javaClass.simpleName)
            throw YeroonUnavailableException(UNAVAILABLE, e)
        }
        return result ?: run {
            log.warn("yeroon play respondeu sem corpo")
            throw YeroonUnavailableException(UNAVAILABLE)
        }
    }

    private fun map(e: RestClientResponseException): RuntimeException {
        val status = e.statusCode.value()
        return when (status) {
            422 -> YeroonRejectedException(errors(e))
            404 -> YeroonNotFoundException()
            409 -> YeroonConflictException()
            401, 403 -> {
                // Chave recusada: problema de configuração, não do usuário.
                log.error("yeroon play recusou a chave {} (status {})", keyPrefix, status)
                YeroonUnavailableException(UNAVAILABLE)
            }
            else -> {
                log.warn("yeroon play indisponível (status {})", status)
                YeroonUnavailableException(UNAVAILABLE)
            }
        }
    }

    private fun errors(e: RestClientResponseException): List<YeroonError> =
        runCatching { e.getResponseBodyAs(Errors::class.java)?.errors }.getOrNull().orEmpty()

    @JsonIgnoreProperties(ignoreUnknown = true)
    private data class Urls(val urls: List<YeroonPartUrl> = emptyList())

    @JsonIgnoreProperties(ignoreUnknown = true)
    private data class Parts(val parts: List<YeroonUploadedPart> = emptyList())

    @JsonIgnoreProperties(ignoreUnknown = true)
    private data class Videos(val videos: List<YeroonVideoSummary> = emptyList())

    @JsonIgnoreProperties(ignoreUnknown = true)
    private data class Errors(val errors: List<YeroonError>? = null)

    private companion object {
        const val UNAVAILABLE = "Serviço de vídeo indisponível."
        val log = LoggerFactory.getLogger(YeroonClientImpl::class.java)
    }
}
