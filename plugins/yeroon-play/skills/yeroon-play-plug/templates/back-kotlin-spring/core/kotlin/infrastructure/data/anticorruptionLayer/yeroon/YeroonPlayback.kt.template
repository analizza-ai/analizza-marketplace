package {base-package}.infrastructure.data.anticorruptionLayer.yeroon

import com.fasterxml.jackson.annotation.JsonIgnoreProperties
import java.net.URI
import java.time.Instant

/**
 * O que interessa de POST /v1/videos/{id}/playback-token. O token em si não é
 * lido: embedUrl e hlsUrl já o carregam, e ele nunca é guardado.
 */
@JsonIgnoreProperties(ignoreUnknown = true)
data class YeroonPlayback(val embedUrl: URI, val hlsUrl: URI?, val expiresAt: Instant)
