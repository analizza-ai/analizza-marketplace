package {base-package}.infrastructure.repositories

import {base-package}.domain.{video-entity}
import {base-package}.domain.repositories.{video-entity}Repository
import java.util.UUID
import org.springframework.stereotype.Repository

@Repository
internal class {video-entity}RepositoryImpl(private val jpa: {video-entity}JpaRepository) : {video-entity}Repository {

    override fun save(video: {video-entity}) {
        jpa.save({video-entity}JpaEntity.fromDomain(video))
    }

    override fun existsById(id: UUID): Boolean = jpa.existsById(id)

    override fun findAllIds(): Set<UUID> = jpa.findAllIds()

    override fun deleteById(id: UUID) = jpa.deleteById(id)
}
