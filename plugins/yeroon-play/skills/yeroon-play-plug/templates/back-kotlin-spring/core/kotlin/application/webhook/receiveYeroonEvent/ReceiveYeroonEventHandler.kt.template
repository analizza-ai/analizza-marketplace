package {base-package}.application.webhook.receiveYeroonEvent

import {base-package}.domain.repositories.WebhookReceiptRepository
import java.time.Instant
import org.slf4j.LoggerFactory
import org.springframework.stereotype.Component

/**
 * Registra o aviso uma vez só (dedupe por deliveryId) e responde rápido. Reação
 * do domínio (ex.: liberar a aula quando o vídeo fica PRONTO) entra aqui, só
 * quando `registerIfNew` devolve true.
 */
@Component
class ReceiveYeroonEventHandler(private val receipts: WebhookReceiptRepository) {

    fun handle(command: ReceiveYeroonEventCommand) {
        val first = receipts.registerIfNew(command.deliveryId, command.eventType, command.videoId, Instant.now())
        log.info("yeroon {} video={} delivery={} novo={}", command.eventType, command.videoId, command.deliveryId, first)
    }

    private companion object {
        val log = LoggerFactory.getLogger(ReceiveYeroonEventHandler::class.java)
    }
}
