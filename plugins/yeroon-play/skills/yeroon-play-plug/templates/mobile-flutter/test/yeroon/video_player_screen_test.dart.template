import 'dart:convert';

import 'package:flutter/material.dart';
import 'package:flutter_test/flutter_test.dart';
import 'package:http/http.dart' as http;
import 'package:http/testing.dart';
import 'package:{flutter-package}/yeroon/api.dart';
import 'package:{flutter-package}/yeroon/video_player_screen.dart';

const id = '3f1c2e4a-5b6d-4e7f-8a9b-0c1d2e3f4a5b';
const base = 'http://back.test/api';
const hls = 'https://play.test/api/play/tok/master.m3u8';

void main() {
  late List<String> calls;

  YeroonApi fakeApi(String status, {String? failureReason, int playbackStatus = 200}) => YeroonApi(
        baseUrl: base,
        client: MockClient((r) async {
          calls.add('${r.method} ${r.url}');
          const headers = {'content-type': 'application/json; charset=utf-8'};
          if (r.method == 'GET' && r.url.toString() == '$base/videos/$id') {
            return http.Response(
              jsonEncode({'videoId': id, 'fileName': 'aula.mp4', 'status': status, 'failureReason': failureReason}),
              200,
              headers: headers,
            );
          }
          if (r.method == 'POST' && r.url.toString() == '$base/videos/$id/playback') {
            if (playbackStatus != 200) return http.Response('{}', playbackStatus, headers: headers);
            return http.Response(
              jsonEncode({'embedUrl': 'https://play.test/embed/tok', 'hlsUrl': hls, 'expiresAt': '2026-10-22T06:00:00Z'}),
              200,
              headers: headers,
            );
          }
          throw StateError('chamada inesperada ${r.method} ${r.url}');
        }),
      );

  // O player de verdade precisa de plataforma: o teste injeta um que só mostra a URL recebida.
  Widget fakePlayer(BuildContext context, Uri url, VoidCallback onError) => Text('player: $url');

  Future<void> show(WidgetTester tester, String videoId, YeroonApi api) async {
    await tester.pumpWidget(MaterialApp(
      home: VideoPlayerScreen(videoId: videoId, api: api, playerBuilder: fakePlayer),
    ));
    await tester.pumpAndSettle();
  }

  setUp(() => calls = []);

  testWidgets('pronto pede playback uma vez e toca o hlsUrl', (tester) async {
    await show(tester, id, fakeApi('PRONTO'));
    expect(find.text('player: $hls'), findsOneWidget);
    expect(calls.where((c) => c.endsWith('/playback')), ['POST $base/videos/$id/playback']);
    expect(find.text('aula.mp4'), findsOneWidget);
  });

  testWidgets('ainda convertendo mostra o status sem pedir playback', (tester) async {
    await show(tester, id, fakeApi('PROCESSANDO'));
    expect(find.text('Status: Convertendo'), findsOneWidget);
    expect(calls.any((c) => c.endsWith('/playback')), isFalse);
    expect(find.textContaining('player:'), findsNothing);
    await tester.pumpWidget(const SizedBox()); // desmonta e para a consulta periódica
  });

  testWidgets('falha mostra o motivo', (tester) async {
    await show(tester, id, fakeApi('FALHOU', failureReason: 'Codec não suportado'));
    expect(find.textContaining('Codec não suportado'), findsOneWidget);
  });

  testWidgets('playback recusado mostra erro', (tester) async {
    await show(tester, id, fakeApi('PRONTO', playbackStatus: 409));
    expect(find.text('Não foi possível tocar o vídeo.'), findsOneWidget);
  });

  testWidgets('id que não é UUID não chama o back', (tester) async {
    await show(tester, '..', fakeApi('PRONTO'));
    expect(find.text('Vídeo não encontrado.'), findsOneWidget);
    expect(calls, isEmpty);
  });
}
