import 'dart:async';

import 'package:flutter/material.dart';

import 'api.dart';
import 'video_status.dart';

/// Lista os vídeos com o status, atualiza sozinha enquanto algum converte e permite excluir (com
/// confirmação). Sem estilo próprio: troque `ListTile`/`TextButton` pelos componentes do projeto.
class VideoList extends StatefulWidget {
  const VideoList({super.key, required this.onOpen, this.api, this.refreshKey = 0, this.onDeleted});

  /// Abre a tela do vídeo — ex.: `Navigator.push` para `VideoPlayerScreen(videoId: id)`.
  final ValueChanged<String> onOpen;
  final YeroonApi? api;

  /// Mude quando um envio terminar: recarrega a lista mesmo com a consulta periódica parada.
  final int refreshKey;

  /// Chamado depois que o back confirma a exclusão.
  final ValueChanged<String>? onDeleted;

  @override
  State<VideoList> createState() => _VideoListState();
}

class _VideoListState extends State<VideoList> {
  static const _pollEvery = Duration(seconds: 5);
  late final YeroonApi _api = widget.api ?? YeroonApi();
  List<VideoSummary>? _videos;
  bool _error = false;
  String? _confirming;
  String? _deleteError;
  Timer? _timer;

  @override
  void initState() {
    super.initState();
    _load();
  }

  @override
  void didUpdateWidget(VideoList old) {
    super.didUpdateWidget(old);
    if (old.refreshKey != widget.refreshKey) _load();
  }

  @override
  void dispose() {
    _timer?.cancel();
    super.dispose();
  }

  Future<void> _load() async {
    try {
      final videos = await _api.listVideos();
      if (!mounted) return;
      setState(() {
        _videos = videos;
        _error = false;
      });
    } catch (_) {
      if (!mounted) return;
      setState(() {
        _error = true;
        _videos ??= [];
      });
    }
    _schedule();
  }

  /// Consulta de novo a cada 5 s só enquanto algum vídeo ainda muda de status.
  void _schedule() {
    final active = _videos?.any((v) => activeStatuses.contains(v.status)) ?? false;
    if (active && _timer == null) {
      _timer = Timer.periodic(_pollEvery, (_) => _load());
    } else if (!active) {
      _timer?.cancel();
      _timer = null;
    }
  }

  Future<void> _remove(String videoId) async {
    setState(() => _deleteError = null);
    try {
      await _api.deleteVideo(videoId);
      if (!mounted) return;
      setState(() {
        _videos = [...?_videos]..removeWhere((v) => v.videoId == videoId);
        _confirming = null;
      });
      widget.onDeleted?.call(videoId);
    } catch (_) {
      if (!mounted) return;
      setState(() {
        _confirming = null;
        _deleteError = 'Não foi possível excluir o vídeo. Só vídeos prontos ou com falha podem ser excluídos.';
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    final videos = _videos;
    return Semantics(
      label: 'Vídeos',
      container: true,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          if (videos == null) const Text('Carregando…'),
          if (_error) const Text('Não foi possível carregar os vídeos.'),
          if (_deleteError != null) Text(_deleteError!),
          if (videos != null && videos.isEmpty && !_error) const Text('Nenhum vídeo ainda.'),
          for (final v in videos ?? const <VideoSummary>[])
            ListTile(
              key: ValueKey(v.videoId),
              leading: v.thumbnailUrl == null ? null : Image.network(v.thumbnailUrl!, width: 96, fit: BoxFit.cover),
              title: Text(v.fileName),
              subtitle: Text(statusLabel(v.status)),
              onTap: () => widget.onOpen(v.videoId),
              trailing: _confirming == v.videoId
                  ? Wrap(children: [
                      TextButton(onPressed: () => _remove(v.videoId), child: const Text('Confirmar exclusão')),
                      TextButton(onPressed: () => setState(() => _confirming = null), child: const Text('Manter')),
                    ])
                  : TextButton(
                      onPressed: () => setState(() => _confirming = v.videoId),
                      child: Text('Excluir', semanticsLabel: 'Excluir ${v.fileName}'),
                    ),
            ),
        ],
      ),
    );
  }
}
