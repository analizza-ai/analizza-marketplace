// Cliente das rotas de vídeo do back do projeto. O app fala só com o back (e com o storage, nas URLs
// assinadas do upload); nunca com a API do yeroon, e nunca tem a chave dela.
import 'dart:convert';

import 'package:http/http.dart' as http;

/// URL do back, passada no build: `flutter run --dart-define={back-url-env}=http://10.0.2.2:8080`.
/// Não é segredo (é a URL do próprio back). No emulador Android, `localhost` é o próprio emulador.
const String _backUrl = String.fromEnvironment('{back-url-env}', defaultValue: 'http://localhost:8080');

/// context-path + prefixo de mapeamento das rotas do back.
const String _backPrefix = '{context-path}{api-routes-prefix}';

/// URL do back + prefixo; as rotas de vídeo ficam em `$apiBase/videos`.
final String apiBase = '${_backUrl.replaceAll(RegExp(r'/+$'), '')}$_backPrefix';

final RegExp _videoIdPattern = RegExp(r'^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$', caseSensitive: false);

/// O `videoId` é um UUID. Qualquer outra coisa (`..`, `.`, vazio, `a/b`) é recusada antes do pedido:
/// `Uri.encodeComponent('..')` continua `..`, e o caminho colapsaria para outra rota do back.
bool isVideoId(String id) => _videoIdPattern.hasMatch(id);

/// O id não é um UUID: o pedido não sai do app.
class InvalidVideoIdException implements Exception {
  InvalidVideoIdException(this.id);
  final String id;
  @override
  String toString() => 'Identificador de vídeo inválido.';
}

/// Resposta de erro do back; `messages` traz os `errors[].message` do problem+json (422).
class YeroonApiException implements Exception {
  YeroonApiException(this.status, [this.messages = const []]);
  final int status;
  final List<String> messages;
  @override
  String toString() => messages.isEmpty ? 'O servidor respondeu $status.' : messages.join(' ');
}

class VideoSummary {
  VideoSummary({required this.videoId, required this.fileName, required this.status, this.createdAt, this.thumbnailUrl});
  factory VideoSummary.fromJson(Map<String, dynamic> j) => VideoSummary(
        videoId: j['videoId'] as String,
        fileName: j['fileName'] as String? ?? '',
        status: j['status'] as String? ?? '',
        createdAt: DateTime.tryParse(j['createdAt'] as String? ?? ''),
        thumbnailUrl: j['thumbnailUrl'] as String?,
      );
  final String videoId;
  final String fileName;
  final String status;
  final DateTime? createdAt;
  final String? thumbnailUrl;
}

class VideoDetail {
  VideoDetail({required this.fileName, required this.status, this.failureReason});
  factory VideoDetail.fromJson(Map<String, dynamic> j) => VideoDetail(
        fileName: j['fileName'] as String? ?? '',
        status: j['status'] as String? ?? '',
        failureReason: j['failureReason'] as String?,
      );
  final String fileName;
  final String status;
  final String? failureReason;
}

/// O que o back devolve do playback. O token vem dentro das URLs: peça de novo a cada abertura, não guarde.
class Playback {
  Playback({required this.embedUrl, required this.hlsUrl, required this.expiresAt});
  factory Playback.fromJson(Map<String, dynamic> j) => Playback(
        embedUrl: Uri.parse(j['embedUrl'] as String),
        hlsUrl: Uri.parse(j['hlsUrl'] as String),
        expiresAt: DateTime.tryParse(j['expiresAt'] as String? ?? ''),
      );
  final Uri embedUrl;
  final Uri hlsUrl;
  final DateTime? expiresAt;
}

class YeroonApi {
  YeroonApi({http.Client? client, String? baseUrl})
      : client = client ?? http.Client(),
        baseUrl = baseUrl ?? apiBase;

  /// Usado também nos `PUT` das partes (URLs assinadas do storage).
  final http.Client client;
  final String baseUrl;

  Uri get videosUri => Uri.parse('$baseUrl/videos');

  /// `$baseUrl/videos/<id><suffix>`; lança [InvalidVideoIdException] se o id não for UUID.
  Uri videoUri(String id, [String suffix = '']) {
    if (!isVideoId(id)) throw InvalidVideoIdException(id);
    return Uri.parse('$baseUrl/videos/${Uri.encodeComponent(id)}$suffix');
  }

  static List<String> problemMessages(http.Response res) {
    try {
      final body = jsonDecode(utf8.decode(res.bodyBytes));
      final errors = body is Map ? body['errors'] : null;
      if (errors is! List) return const [];
      return [
        for (final e in errors)
          if (e is Map && e['message'] is String) e['message'] as String,
      ];
    } catch (_) {
      return const [];
    }
  }

  /// Lança [YeroonApiException] quando a resposta não é 2xx.
  static http.Response ensureOk(http.Response res) {
    if (res.statusCode >= 200 && res.statusCode < 300) return res;
    throw YeroonApiException(res.statusCode, problemMessages(res));
  }

  static dynamic decode(http.Response res) => jsonDecode(utf8.decode(res.bodyBytes));

  Future<List<VideoSummary>> listVideos() async {
    final res = ensureOk(await client.get(videosUri));
    final videos = (decode(res) as Map<String, dynamic>)['videos'] as List;
    return [for (final v in videos) VideoSummary.fromJson(v as Map<String, dynamic>)];
  }

  Future<VideoDetail> getVideo(String id) async {
    final uri = videoUri(id);
    return VideoDetail.fromJson(decode(ensureOk(await client.get(uri))) as Map<String, dynamic>);
  }

  /// Exclui no back. Vídeo ainda em conversão responde 422 (`video.deletable`).
  Future<void> deleteVideo(String id) async {
    final uri = videoUri(id);
    ensureOk(await client.delete(uri));
  }

  /// Pede um playback novo (só com o vídeo PRONTO; antes disso o back responde 409).
  Future<Playback> requestPlayback(String id) async {
    final uri = videoUri(id, '/playback');
    return Playback.fromJson(decode(ensureOk(await client.post(uri))) as Map<String, dynamic>);
  }
}
